; =============================================================================
; os8088 - tests/multiseg/msegpart.inc
;
; The body every one of MSEG's parts shares (SPEC.md 20.12). A part is a
; separately assembled `nasm -f bin` binary at org 0 that names no label of
; the package's: the two agree about nothing except this file's little ABI.
;
;   +0  jmp short mp_entry      the far-call target, at offset 0 so a caller
;                               needs no constant of its own
;   +2  'MSG'                   the signature, which is what says the package
;   +5  index                   put THESE bytes at THIS segment
;   +6  word  the data area's expected sum
;   +8  word  its first offset
;   +10 word  its last offset + 1
;
; VERBS (AL, far-called, DS is the CALLER's on entry):
;   0   AX = 0x5300 | index     "this code ran" - a value only this module
;                               computes, so a far call into a claim that was
;                               never filled cannot produce it
;   1   AX = the sum of the data area, computed HERE, over CS
;
; The two answers are independent on purpose. Verb 0 says the segment is
; EXECUTABLE at the offset op_seg named; verb 1 says its DATA is the data that
; was packed. A wrong segment fails the first, a short or misaligned read
; fails the second, and the signature the caller reads for itself fails both
; without either being called at all.
;
; DS IS SWITCHED AND RESTORED (SPEC.md 20.12.5's data-carrying model): the sum
; runs over this module's own bytes, so DS has to name this segment for the
; body's duration, and the caller's DS is put back before the retf. Nothing
; here holds a caller pointer across the switch, which is the rule that makes
; the model safe.
; =============================================================================

    cpu 8086
    bits 16
    org 0

; THE EXPECTED SUM IS COMPUTED BY THE PREPROCESSOR, running the same algorithm
; the code below runs, over the same generated bytes. Two implementations of
; one formula, one at build time and one on the 8086 - so a part whose data
; arrived wrong fails against a figure that was never in the same place as the
; data. It has to come first: mp_sum is emitted before the bytes it describes,
; and %assign is evaluated top to bottom.
%assign MP_S 0
%assign MP_I 0
%rep MP_DATA_N
    %assign MP_B ((MP_I * 7 + MP_INDEX * 29 + 13) & 0xFF)
    %assign MP_S (MP_S + MP_B) & 0xFFFF
    %assign MP_S ((MP_S << 1) | (MP_S >> 15)) & 0xFFFF
    %assign MP_I MP_I + 1
%endrep

    jmp short mp_entry          ; +0
    db 'MSG'                    ; +2
    db MP_INDEX                 ; +5
mp_sum:  dw MP_S                ; +6  the preprocessor's answer
mp_dlo:  dw mp_data             ; +8
mp_dhi:  dw mp_dend             ; +10

; -----------------------------------------------------------------------------
; mp_entry - the far-called body
; in:  AL = verb, DS = the caller's
; out: AX = the answer; every other register preserved, DS restored
; -----------------------------------------------------------------------------
mp_entry:
    push bx
    push cx
    push si
    push ds
    push cs
    pop ds                      ; ...for the body's duration, and no longer
    cmp al, 1
    je .sum
    mov ax, 0x5300 | MP_INDEX   ; verb 0: only this module knows this
    jmp short .out
.sum:
    mov si, mp_data
    mov cx, mp_dend - mp_data
    xor ax, ax
.next:
    mov bl, [si]
    xor bh, bh
    add ax, bx
    rol ax, 1                   ; a rotate, so a TRANSPOSITION is caught: a
    inc si                      ; plain sum would pass on the same bytes in
    loop .next                  ; the wrong order, which is what a misaligned
.out:                           ; read actually produces
    pop ds
    pop si
    pop cx
    pop bx
    retf

; --- the data area: a pattern, not padding -----------------------------------
; Deterministic and index-dependent, so part 0's bytes cannot pass as part 1's
; - which is exactly the failure a run whose base arithmetic is off by one
; part would produce, and the one a hand-check of "is there something there"
; would miss.
mp_data:
%assign MP_I 0
%rep MP_DATA_N
    db (MP_I * 7 + MP_INDEX * 29 + 13) & 0xFF
    %assign MP_I MP_I + 1
%endrep
mp_dend:
