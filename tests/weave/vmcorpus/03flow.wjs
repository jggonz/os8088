// if / while / for / break / continue, and locals
var total; var count;
function sumTo(n) {
  var i; var s;
  s = 0;
  for (i = 1; i <= n; i = i + 1) {
    if (i == 4) { continue; }
    if (i > 8) { break; }
    s = s + i;
  }
  return s;
}
function main() {
  var k;
  total = sumTo(10);
  count = 0;
  k = 0;
  while (k < 5) { count++; k = k + 1; }
  count = count + 0;
}
