/* menu.rc - the menu and accelerators of menu.c (WIN16 fixture, S5) */
#include <windows.h>
#include "menu.h"

W16MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tF2",    IDM_NEW
        MENUITEM SEPARATOR
        MENUITEM "E&xit",       IDM_EXIT
    END
    POPUP "&Colour"
    BEGIN
        MENUITEM "&Red",        IDM_RED, CHECKED
        MENUITEM "&Green",      IDM_GREEN
        MENUITEM "&Blue",       IDM_BLUE
        MENUITEM SEPARATOR
        MENUITEM "&Unavailable", IDM_GREY, GRAYED
    END
END

W16ACCEL ACCELERATORS
BEGIN
    VK_F2, IDM_NEW, VIRTKEY
END
