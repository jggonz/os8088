/* longname.rc - longname.c's resources (WIN16 fixture, SPEC.md 124.10):
 * a dialog named in 21 characters (Microsoft Arcade's Asteroids' own
 * dialog name), a menu in 40, a bitmap in 255 (the most a resource table's
 * count byte can say), a resource of a 28-character type, accelerators in
 * 26, and a bitmap by number for "#300". The bitmaps are mkbmp.py's. */
#include <windows.h>

NUMBEROFPLAYERSDIALOG DIALOG 20, 20, 120, 50
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Long name"
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 40, 20, 40, 14
END

MENUWITHANAMEOFFORTYCHARACTERSEXACTLY040 MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", 100
    END
    MENUITEM "&Help", 101
END

BITMAPNAMEDATTHEFULLLENGTHANRCTABLECOUNTBYTECANSAYBITMAPNAMEDATTHEFULLLENGTHANRCTABLECOUNTBYTECANSAYBITMAPNAMEDATTHEFULLLENGTHANRCTABLECOUNTBYTECANSAYBITMAPNAMEDATTHEFULLLENGTHANRCTABLECOUNTBYTECANSAYBITMAPNAMEDATTHEFULLLENGTHANRCTABLECOUNTBYTECANSAYBI255 BITMAP "w16mono.bmp"
300 BITMAP "w16color.bmp"

LONGDATA ALONGUSERTYPENAMEPASTFIFTEEN
BEGIN
    "LONGNAME DATA\0"
END

ACCELERATORSNAMEDINTWENTYS ACCELERATORS
BEGIN
    "A", 100, VIRTKEY, CONTROL
END
