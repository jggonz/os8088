+import os, sys, collections
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+sys.path.insert(0, os.path.join(ROOT, "tools"))
+os.environ.setdefault("OS88_BUILD", "build/proto")
+os.environ.setdefault("OS88_DEFINES", "DCPROTO")
+import os88sym
+os88sym._SHIPPED_DEFS = os88sym._SHIPPED_DEFS + ("DCPROTO",)
+import os88marty, os88ui
+CELLS = {0x467: "HLINE", 0x46E: "VLINE", 0x475: "FILL", 0x47C: "FRAME", 0x483: "FILL_GRAY",
+         0x48A: "XOR_RECT", 0x491: "XOR_FILL", 0x498: "FCHAR", 0x49F: "FSTR", 0x4A6: "FRUN",
+         0x4AD: "BLIT1", 0x4B3: "BLIT4", 0x4B9: "PIXEL", 0x4C0: "FILL_PAT", 0x4C7: "SCROLL",
+         0x4CE: "ICON", 0x4D5: "SAVE", 0x4DC: "REST", 0x4E3: "CLIP_TEST", 0x4EA: "DAMAGE",
+         0x4F1: "MOUSE", 0x4F8: "BLITP", 0x4FE: "WM_CONTENT", 0x502: "CLIP_SET"}
+with os88ui.boot(os.path.join(ROOT, "build/proto/os8088-360.img"),
+                 apps=os.path.join(ROOT, "build/proto/dcb360.img")) as ui:
+    for f, t in (("PIANOC2.O88", "Piano"), ("CALCC2.O88", "Calculator")):
+        tg = [0x600 + a for a in CELLS] + ["wm_draw_win.uncharged"]
+        with os88marty.bp_trace(ui.m, *tg) as tr:
+            ui.path("B:/" + f)
+            ui.wait_window(t)
+            def done():
+                hs = tr.hits
+                k = next((i for i, h in enumerate(hs) if h["addr"] - 0x600 in CELLS), None)
+                return k is not None and any(h["name"] == "wm_draw_win.uncharged" for h in hs[k:])
+            tr.until(done, "paint", 300)
+        c = collections.Counter(CELLS.get(h["addr"] - 0x600, h["name"]) for h in tr.hits)
+        print(f, sum(v for k, v in c.items() if k in CELLS.values()), dict(c))
+        ui.settle()
+        ui.close(ui.window(t))
+        ui.settle()
