+#!/bin/sh
+# tests/dcrig/build.sh - docs/plans/CONTENT-COORDS-PLAN.md's measuring rig.
+#
+# Builds the PROTOTYPE kernel (kernel/dcproto.inc, -DDCPROTO) and its 360KB
+# system disk into build/proto/ - a private tree, so build/ is never touched -
+# and the B: disk the three drivers boot: the bench package in both variants,
+# Piano and Calc stock / flipped (-DOS88_CONTENT, source unchanged) / cleaned
+# (the stock source with tests/dcrig/<pkg>.diff applied - the clean-up IS the
+# diff), Piano's negative control, and TameGram stock / cleaned.
+#
+#   sh tests/dcrig/build.sh
+#   python3 tests/dcrig/dcbench.py     # a call, screen against content
+#   python3 tests/dcrig/dcflip.py      # stock against flipped, bit for bit
+#   python3 tests/dcrig/dcpaint.py     # a whole first paint
+#   python3 tests/dcrig/dcksec.py      # the three kernels' sections, stock vs rig
+#
+# NOTHING HERE IS A SUITE ROW and none of it may become one as it stands: it
+# all needs the rig kernel, which nothing that ships builds.
+set -e
+cd "$(dirname "$0")/../.."
+P=build/proto
+mkdir -p $P
+# os88kz.py's second pass runs $NASM as ONE word, so a define rides a wrapper
+W=$(pwd)/$P/nasm-dc
+printf '#!/bin/sh\nexec nasm -DDCPROTO "$@"\n' > "$W"
+chmod +x "$W"
+# NOOVLCHK: the blit cell is near-called and ends in retf, api_rs's shape,
+# which os88ovlchk allows by name and not for a prototype
+make -j3 BUILD=$P NASM="$W" NOOVLCHK=1 $P/os8088-360.img
+
+A="nasm -f bin -w+error -DDCPROTO -I apps/"
+$A -DDCB_CREL -o $P/dcbench.bin tests/dcrig/dcbench.asm
+$A -o $P/dcbenchs.bin tests/dcrig/dcbench.asm
+for p in piano calc tamegram; do
+    $A -o $P/$p.bin apps/$p/$p.asm
+done
+$A -DOS88_CONTENT -o $P/pianoc.bin apps/piano/piano.asm
+$A -DOS88_CONTENT -o $P/calcc.bin apps/calc/calc.asm
+$A -DOS88_CONTENT -DDCB_BREAK -o $P/pianob.bin apps/piano/piano.asm
+mkdir -p $P/src
+for p in piano calc tamegram; do
+    cp apps/$p/$p.asm $P/src/$p.asm
+    patch -s $P/src/$p.asm tests/dcrig/$p.diff
+done
+$A -DOS88_CONTENT -o $P/pianoc2.bin $P/src/piano.asm
+$A -DOS88_CONTENT -o $P/calcc2.bin $P/src/calc.asm
+$A -DOS88_CONTENT -o $P/tgc2.bin $P/src/tamegram.asm
+L=""
+for b in dcbench dcbenchs piano pianoc pianob pianoc2 calc calcc calcc2 tamegram tgc2; do
+    python3 tools/os88pkg.py --compress-if=lz4 $P/$b.bin -o $P/$b.o88
+    L="$L $P/$b.o88"
+done
+python3 tools/os88disk.py -o $P/dcb360.img --size 360 $L
