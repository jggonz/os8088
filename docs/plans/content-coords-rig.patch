--- /dev/null
+++ b/tests/dcrig/dcsurvey.py
@@ -0,0 +1,43 @@
+import os, re, sys, collections
+root = sys.argv[1]
+DRAW = ["GFX_PIXEL","GFX_HLINE","GFX_VLINE","GFX_FILL","GFX_FRAME","GFX_FILL_GRAY","GFX_XOR_RECT","GFX_XOR_FILL",
+ "FONT_CHAR_XPARENT","FONT_STR_XPARENT","FONT_RUN","ICON_DRAW","GFX_BLIT1","GFX_BLIT4","GFX_BLITP","GFX_SCROLL",
+ "GFX_SAVE","GFX_REST","GFX_SPANS","GFX_FILL_PAT","GFX_POINTS","GFX_LINE"]
+GEOM = ["WM_CONTENT","WM_GEOM","WM_CLIP_SET","WM_CLIP_TEST","WM_CLIP_CLEAR"]
+pat = re.compile(r"^\s*(?:[\w.]+:\s*)?call\s+(?:far\s+)?OSAPI_([A-Z0-9_]+)", re.M)
+
+def scantext(t, c):
+    t = re.sub(r";.*", "", t)
+    for m in pat.finditer(t):
+        c[m.group(1)] += 1
+
+def scan(p):
+    c = collections.Counter()
+    if os.path.isdir(p):
+        for dp, dn, fn in os.walk(p):
+            for f in fn:
+                if f.endswith(('.asm', '.inc')):
+                    scantext(open(os.path.join(dp, f), errors='replace').read(), c)
+    else:
+        scantext(open(p, errors='replace').read(), c)
+    return c
+
+rows = []
+tot = collections.Counter()
+for base in ['apps', 'tests', 'drivers']:
+    for e in sorted(os.listdir(os.path.join(root, base))):
+        p = os.path.join(root, base, e)
+        if not (os.path.isdir(p) or e.endswith('.inc') or (base == 'tests' and e.endswith('.asm'))):
+            continue
+        c = scan(p)
+        d = sum(c[k] for k in DRAW)
+        g = sum(c[k] for k in GEOM)
+        if d or g:
+            rows.append((base + '/' + e, d, c['WM_CONTENT'], c['WM_GEOM'], c['WM_CLIP_SET'], c['GFX_LOCK'],
+                         ' '.join(f"{k}:{c[k]}" for k in DRAW if c[k])))
+            for k in DRAW + GEOM + ['GFX_LOCK']:
+                tot[(base, k)] += c[k]
+for r in rows:
+    print("%-30s draw=%4d content=%3d geom=%3d clipset=%2d lock=%3d  %s" % r)
+for base in ['apps', 'tests', 'drivers']:
+    print(base, sum(tot[(base, k)] for k in DRAW), {k: tot[(base, k)] for k in DRAW + GEOM + ['GFX_LOCK'] if tot[(base, k)]})
