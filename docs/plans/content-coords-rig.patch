index 00000000..2e09080b
--- /dev/null
+++ b/tests/dcrig/dcpaint.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""dcpaint - what content coordinates cost a WHOLE paint, package by package.
+
+docs/plans/CONTENT-COORDS-PLAN.md: tests/dcbench.py prices one call; this
+prices what a user waits for. Each package is opened from B: on the rig kernel
+(build/proto) and the cycles from wm_draw_win's `.paint` to its `.uncharged`
+- the W_PAINT dispatch, the drawing context's bracket on a content package,
+and every primitive the paint calls - are read off MartyPC's counter. The
+STOCK package, its FLIPPED twin (-DOS88_CONTENT, source unchanged) and its
+CLEANED twin (origin arithmetic taken out) are timed in turn.
+
+NOT a suite row.   sh tests/dcrig/build.sh && python3 tests/dcrig/dcpaint.py
+"""
+import os, sys
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+sys.path.insert(0, os.path.join(ROOT, "tools"))
+os.environ.setdefault("OS88_BUILD", "build/proto")
+os.environ.setdefault("OS88_DEFINES", "DCPROTO")
+import os88sym                                         # noqa: E402
+os88sym._SHIPPED_DEFS = os88sym._SHIPPED_DEFS + ("DCPROTO",)
+import os88marty, os88ui                               # noqa: E402
+
+REPS = 4      # IRQ0 lands in a ~150 ms paint two or three times: take the MIN
+RUNS = [("Piano", ["PIANO.O88", "PIANOC.O88", "PIANOC2.O88"]),
+        ("Calc", ["CALC.O88", "CALCC.O88", "CALCC2.O88"])]
+
+
+def paint_cycles(ui, fname, title):
+    """The package's OWN first paint: the `.paint` hit whose DI is its window
+    record (the Disk window repaints on the same double-click, and a span
+    that does not ask which window it timed timed that one)."""
+    with os88marty.bp_trace(ui.m, "wm_draw_win.paint", "wm_draw_win.uncharged",
+                            regs=True) as tr:
+        ui.path("B:/" + fname)
+        w = ui.wait_window(title)
+        ptr = ui._S("wm_wins") - 0x600 + w.i * os88ui.geom.WIN_SIZE  # linear -> offset
+
+        def mine():
+            hs = tr.hits
+            for i, h in enumerate(hs):
+                if h["name"] == "wm_draw_win.paint" and \
+                        (h.get("regs", {}).get("di", -1) & 0xFFFF) == ptr:
+                    return any(x["name"] == "wm_draw_win.uncharged"
+                               for x in hs[i + 1:])
+            return False
+        tr.until(mine, "the package's own paint", 300)
+    hs = tr.hits
+    for i, h in enumerate(hs):
+        if h["name"] == "wm_draw_win.paint" and (h["regs"].get("di", -1) & 0xFFFF) == ptr:
+            e = next(x for x in hs[i + 1:] if x["name"] == "wm_draw_win.uncharged")
+            return e["cycles"] - h["cycles"]
+    return None
+
+
+def main():
+    sysimg = os.path.join(ROOT, "build/proto/os8088-360.img")
+    apps = os.path.join(ROOT, "build/proto/dcb360.img")
+    with os88ui.boot(sysimg, apps=apps) as ui:
+        for title, files in RUNS:
+            base = None
+            for f in files:
+                cs = []
+                for _ in range(REPS):
+                    cs.append(paint_cycles(ui, f, title))
+                    ui.settle()
+                    ui.close(ui.window(title))
+                    ui.settle()
+                c = min(cs)
+                base = base or c
+                print("%-6s %-12s W_PAINT min %8d cycles  %7.2f ms  %+.1f%%   all %s"
+                      % (title, f, c, c / 4772.727, 100.0 * (c - base) / base, cs))
+
+
+if __name__ == "__main__":
+    main()
