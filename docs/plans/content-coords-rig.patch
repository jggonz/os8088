+++ b/tests/dcrig/dccsurvey.py
@@ -0,0 +1,26 @@
+import os, re, sys, collections
+root = sys.argv[1]
+draw = re.compile(r"\bos88_(gfx_(?:pixel|points|hline|vline|fill|frame|fill_gray|xor_rect|xor_fill|fill_pat|scroll|blit1|blit4|blitp)|font_(?:run|char_xparent|str_xparent))\s*\(")
+cont = re.compile(r"\bos88_wm_content\s*\(")
+geom = re.compile(r"\bos88_wm_geom\s*\(")
+clip = re.compile(r"\bos88_wm_clip_set\s*\(")
+tot = collections.Counter()
+for e in sorted(os.listdir(os.path.join(root, 'apps'))):
+    p = os.path.join(root, 'apps', e)
+    if not os.path.isdir(p) or e == 'cc':
+        continue
+    c = collections.Counter(); n = cn = g = cl = 0
+    for dp, dn, fn in os.walk(p):
+        for f in fn:
+            if f.endswith(('.c', '.h')):
+                t = open(os.path.join(dp, f), errors='replace').read()
+                t = re.sub(r"/\*.*?\*/", "", t, flags=re.S)
+                t = re.sub(r"//.*", "", t)
+                for m in draw.finditer(t):
+                    c[m.group(1)] += 1
+                cn += len(cont.findall(t)); g += len(geom.findall(t)); cl += len(clip.findall(t))
+    n = sum(c.values())
+    if n or cn:
+        print("%-12s draw=%4d content=%3d geom=%3d clipset=%2d %s" % (e, n, cn, g, cl, dict(c)))
+        tot.update(c)
+print(sum(tot.values()), dict(tot))
diff --git a/tests/dcrig/dcflip.py b/tests/dcrig/dcflip.py
new file mode 100644
index 00000000..809b5bea
--- /dev/null
+++ b/tests/dcrig/dcflip.py
@@ -0,0 +1,135 @@
+#!/usr/bin/env python3
+"""dcflip - does a package FLIPPED to content coordinates draw the same pixels?
+
+docs/plans/CONTENT-COORDS-PLAN.md's migration claim, measured: a package
+assembled with `-DOS88_CONTENT` against the rig SDK (apps/os88api.inc under
+DCPROTO) reaches the CONTENT cells under its old slot names, wm_pkgcall sets
+its drawing context, WM_CONTENT answers (0,0) and clicks arrive content-
+relative - so its source is UNCHANGED and every `+ origin` it does adds zero.
+This opens each STOCK package and its flipped twin on the rig kernel, reads
+the window's content off the 1bpp framebuffer after open and after each
+scripted click, and compares the two bit for bit.
+
+NOT a suite row: it needs build/proto (the rig) and the B: disk the plan's
+appendix builds.   sh tests/dcrig/build.sh && python3 tests/dcrig/dcflip.py
+"""
+import os, sys
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+sys.path.insert(0, os.path.join(ROOT, "tools"))
+os.environ.setdefault("OS88_BUILD", "build/proto")
+os.environ.setdefault("OS88_DEFINES", "DCPROTO")
+import os88sym                                         # noqa: E402
+os88sym._SHIPPED_DEFS = os88sym._SHIPPED_DEFS + ("DCPROTO",)
+import os88marty, os88ui                               # noqa: E402
+
+# (stock file, flipped file, window title, clicks as CONTENT offsets)
+# PIANOC/CALCC are the SDK switch alone (source unchanged); PIANOC2/CALCC2
+# are the same with the origin arithmetic taken out (plan 3.2); PIANOB is the
+# negative control - flipped, but WM_CONTENT left answering the SCREEN origin,
+# so every coordinate is offset twice and must NOT match.
+PC = [(30, 100), (150, 100), (60, 60)]
+CC = [(20, 60), (60, 60), (100, 90), (20, 120)]
+PAIRS = [("PIANO.O88", "PIANOB.O88", "Piano", [(30, 100)]),
+         ("PIANO.O88", "PIANOC.O88", "Piano", PC),
+         ("PIANO.O88", "PIANOC2.O88", "Piano", PC),
+         ("CALC.O88", "CALCC.O88", "Calc", CC),
+         ("CALC.O88", "CALCC2.O88", "Calc", CC),
+         ("TAMEGRAM.O88", "TAMEGRAM.O88", "TameGram", []),   # its own noise
+         ("TAMEGRAM.O88", "TGC2.O88", "TameGram", []),
+         ]
+if len(sys.argv) > 1:
+    PAIRS = [p for p in PAIRS if p[1] in sys.argv[1:]]
+
+
+BAND = 32
+MBAR_H = 20
+
+
+def outside(ui, w):
+    """A BAND px ring round the window's frame and shadow - below the menu bar
+    and on no other window, so what is compared is desktop the package may
+    not touch, and nothing else that changes between two runs."""
+    wid, hgt, rows = ui.m.vram()
+    others = [o for o in ui.windows() if o.visible and o.i != w.i]
+
+    def keep(x, y):
+        if y < MBAR_H or y >= hgt or x < 0 or x >= wid:
+            return False
+        if w.x <= x <= w.x + w.w and w.y <= y <= w.y + w.h:
+            return False
+        return not any(o.x <= x <= o.x + o.w and o.y <= y <= o.y + o.h
+                       for o in others)
+    return [tuple(rows[y][x] for x in range(w.x - BAND, w.x + w.w + BAND + 1)
+                  if keep(x, y))
+            for y in range(w.y - BAND, w.y + w.h + BAND + 1)]
+
+
+def grab(ui, w):
+    """The window's frame rect, as rows of bits, off the CGA framebuffer."""
+    wid, hgt, rows = ui.m.vram()
+    x1, y1, x2, y2 = w.x, w.y, w.x + w.w - 1, w.y + w.h - 1
+    out = []
+    for y in range(y1, y2 + 1):
+        r = rows[y]
+        out.append(tuple(r[x] for x in range(x1, x2 + 1)))
+    return out
+
+
+ANIMATED = {"TameGram": 28}         # title -> the static band's height
+
+
+def run_one(ui, fname, title, clicks):
+    ui.path("B:/" + fname)
+    w = ui.wait_window(title)
+    if title in ANIMATED:
+        # A GAME: its worker never stops drawing, so there is no settled
+        # frame. Run a fixed span of guest time, stop, and compare the
+        # static band (the HUD) and the desktop round the window - the
+        # matrix under it is random by design.
+        ui.m.advance(frames=120)
+        w = ui.window(title)
+        wid, hgt, rows = ui.m.vram()
+        cy = w.y + os88ui.geom.TITLE_H
+        band = [tuple(rows[y][w.x:w.x + w.w]) for y in range(cy, cy + ANIMATED[title])]
+        o = outside(ui, w)
+        ui.m.run()
+        ui.close(ui.window(title))
+        ui.settle()
+        return (w.x, w.y, w.w, w.h), [band], [o]
+    ui.settle()
+    w = ui.window(title)
+    pics = [grab(ui, w)]
+    outs = [outside(ui, w)]
+    cx, cy = w.x + 1, w.y + os88ui.geom.TITLE_H
+    for (dx, dy) in clicks:
+        ui.mo.click(cx + dx, cy + dy)
+        ui.settle()
+        pics.append(grab(ui, ui.window(title)))
+        outs.append(outside(ui, ui.window(title)))
+    ui.close(ui.window(title))
+    ui.settle()
+    return (w.x, w.y, w.w, w.h), pics, outs
+
+
+def main():
+    sysimg = os.path.join(ROOT, "build/proto/os8088-360.img")
+    apps = os.path.join(ROOT, "build/proto/dcb360.img")
+    bad = 0
+    with os88ui.boot(sysimg, apps=apps) as ui:
+        for stock, flip, title, clicks in PAIRS:
+            g0, a, oa = run_one(ui, stock, title, clicks)
+            g1, b, ob = run_one(ui, flip, title, clicks)
+            for i, (p, q) in enumerate(zip(a, b)):
+                diff = sum(1 for r0, r1 in zip(p, q) for u, v in zip(r0, r1) if u != v)
+                odiff = sum(1 for r0, r1 in zip(oa[i], ob[i]) for u, v in zip(r0, r1) if u != v)
+                lit = sum(sum(r) for r in p)
+                tag = "open" if i == 0 else "click %d %s" % (i, clicks[i - 1])
+                print("%-6s %-10s %-16s geom %s/%s  lit %6d  differing %d  outside the window %d"
+                      % (title, flip, tag, g0, g1, lit, diff, odiff))
+                bad += diff != 0 or g0 != g1
+    print("FLIP IDENTICAL" if not bad else "FLIP DIFFERS (%d)" % bad)
+    return 1 if bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
