index 00000000..7227c749
--- /dev/null
+++ b/tests/dcrig/dcbench.py
@@ -0,0 +1,126 @@
+#!/usr/bin/env python3
+"""dcbench - what a CONTENT cell costs over a SCREEN cell, on a 4.77 MHz 8088.
+
+docs/plans/CONTENT-COORDS-PLAN.md's measurement, and NOT a suite row: it needs
+the plan's prototype kernel (kernel/dcproto.inc, built with -DDCPROTO into
+build/proto/) and the two DCBENCH packages, none of which ships. The plan's
+appendix has the commands that build them.
+
+It opens DCBENCH (header PKGF_CREL) from B:, whose one W_PAINT draws the same
+pixels through the shipped SCREEN cell and through the rig's CONTENT cell, as
+back-to-back runs of identical calls. A breakpoint on each cell records
+MartyPC's cycle counter at every hit; the gap between two consecutive hits on
+one cell is one whole call (cell, primitive and return), so the two medians'
+difference is the content cell's price. It then opens DCBENCHS (no PKGF_CREL)
+and prices wm_pkgcall's drawing-context bracket from its own labels.
+
+    sh tests/dcrig/build.sh && python3 tests/dcrig/dcbench.py [--machine NAME]
+"""
+import argparse, os, statistics, sys
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+sys.path.insert(0, os.path.join(ROOT, "tools"))
+os.environ.setdefault("OS88_BUILD", "build/proto")
+os.environ.setdefault("OS88_DEFINES", "DCPROTO")
+import os88sym                                         # noqa: E402
+os88sym._SHIPPED_DEFS = os88sym._SHIPPED_DEFS + ("DCPROTO",)   # not a knob
+import os88marty, os88ui                               # noqa: E402
+
+KSEG = 0x60
+CELLS = [("FILL 8x8", 0x0038, 0x0475, 8, "gfx_fill"),
+         ("HLINE 64px", 0x0028, 0x0467, 8, "gfx_hline"),
+         ("FONT_RUN 8 cells", 0x01E5, 0x04A6, 4, "font_run_x"),
+         ("BLIT1 16x8", 0x0320, 0x04AD, 4, "gfx_blit1"),
+         ("FONT_CHAR 1 cell", 0x0060, 0x0498, 8, "font_char"),
+         ("FRAME 40x20", 0x0040, 0x047C, 8, "gfx_frame")]
+
+
+def gaps(hits, addr):
+    cyc = [h["cycles"] for h in hits if h["addr"] == addr]
+    return cyc, [b - a for a, b in zip(cyc, cyc[1:])]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--machine", default="os8088_5150_cga")
+    a = ap.parse_args()
+    sysimg = os.path.join(ROOT, "build/proto/os8088-360.img")
+    apps = os.path.join(ROOT, "build/proto/dcb360.img")
+    with os88ui.boot(sysimg, apps=apps, machine=a.machine) as ui:
+        m = ui.m
+        tg = []
+        for _, s, c, _n, ent in CELLS:
+            tg += [(KSEG << 4) + s, (KSEG << 4) + c, ent]
+        with os88marty.bp_trace(m, *tg) as tr:
+            ui.path("B:/DCBENCH.O88")
+            last = (KSEG << 4) + CELLS[-1][2]
+            tr.until(lambda: sum(1 for h in tr.hits if h["addr"] == last)
+                     >= CELLS[-1][3], "every bench call", 600)
+        hits = tr.hits
+        ui.settle()
+        w = ui.window("DCBench")
+        ox, oy = w.x + 1, w.y + os88ui.geom.TITLE_H
+        _w, _h, rows = m.vram()
+
+        def lit(x1, y1, x2, y2):
+            return sum(rows[y][x] for y in range(y1, y2 + 1)
+                       for x in range(x1, x2 + 1))
+        # left of the content: the frame's border column (ox-1) and three
+        # columns of desktop beyond it, for each of the four spills
+        print("SPILL ZONES (lit pixels in the 4 columns left of the content; "
+              "untouched = border + desktop dither):")
+        for tag, y in (("content FILL at x=-4 ", oy + 96),
+                       ("screen  FILL at ox-4", oy + 126),
+                       ("content RUN at x=-12", oy + 120),
+                       ("screen  RUN at ox-12", oy + 150)):
+            print("   %s  rows %d..%d: %d of 32 lit" % (tag, y, y + 7,
+                                                   lit(ox - 4, y, ox - 1, y + 7)))
+            for yy in range(y, y + 8):
+                print("      " + "".join("#" if rows[yy][x] else "." for x in range(ox - 16, ox + 16)))
+        print("machine %s, %d hits" % (a.machine, len(hits)))
+        print("%-18s %9s %9s %8s" % ("call", "screen", "content", "extra"))
+        def prolog(cell, ent):
+            out = []
+            for i, h in enumerate(hits):
+                if h["addr"] == cell:
+                    nx = next((y for y in hits[i + 1:] if y["name"] == ent), None)
+                    if nx:
+                        out.append(nx["cycles"] - h["cycles"])
+            return out
+        for name, s, c, n, ent in CELLS:
+            ps = prolog((KSEG << 4) + s, ent)
+            pc = prolog((KSEG << 4) + c, ent)
+            print("   %-18s cell -> %s entry: screen %s  content %s" % (name, ent, ps, pc))
+        for name, s, c, n, ent in CELLS:
+            _, gs = gaps(hits, (KSEG << 4) + s)
+            _, gc = gaps(hits, (KSEG << 4) + c)
+            gs, gc = gs[:n - 1], gc[:n - 1]
+            ms, mc = statistics.median(gs), statistics.median(gc)
+            print("%-18s %9d %9d %+8d   (%+.1f%%)  screen %s content %s"
+                  % (name, ms, mc, mc - ms, 100.0 * (mc - ms) / ms, gs, gc))
+        # --- the per-callback bracket: wm_pkgcall's DC arm -----------------
+        pts = ["wm_pkgcall", "wm_pkgcall.crel", "wm_pkgcall.crelgo",
+               "wm_pkgcall.crelret", "wm_pkgcall.back"]
+        ui.close(ui.window("DCBench"))
+        with os88marty.bp_trace(m, *pts) as tr2:
+            ui.path("B:/DCBENCH.O88")
+            tr2.until(lambda: tr2.count("wm_pkgcall.back") >= 1,
+                      "a CREL dispatch", 300)
+        h = tr2.hits
+        for i, x in enumerate(h):
+            if x["name"] == "wm_pkgcall.crel":
+                seq = h[i:i + 3]
+                if [y["name"] for y in seq] == ["wm_pkgcall.crel",
+                                                "wm_pkgcall.crelgo",
+                                                "wm_pkgcall.crelret"]:
+                    nxt = next((y for y in h[i + 3:]
+                                if y["name"] == "wm_pkgcall.back"), None)
+                    print("DC bracket: set %d cycles (push x4 + dc_set),"
+                          " restore %s cycles (pop x4 + jmp)"
+                          % (seq[1]["cycles"] - seq[0]["cycles"],
+                             nxt["cycles"] - seq[2]["cycles"] if nxt else "?"))
+                    break
+
+
+if __name__ == "__main__":
+    main()
