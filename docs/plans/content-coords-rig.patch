index 00000000..39dd6140
--- /dev/null
+++ b/tests/dcrig/dcbench.asm
@@ -0,0 +1,244 @@
+; =============================================================================
+; os8088 - tests/dcrig/dcbench.asm
+;
+; DCBENCH: the measuring package for docs/plans/CONTENT-COORDS-PLAN.md. It is
+; built ONLY against that plan's prototype kernel (kernel/dcproto.inc, the
+; DCPROTO rig) and ships nowhere.
+;
+; One W_PAINT draws the SAME pixels twice over for each primitive priced -
+; once through the shipped SCREEN cell with the screen coordinates already in
+; registers, once through the rig's CONTENT cell with content coordinates -
+; each as eight (or four) back-to-back calls with nothing between them but the
+; register loads the call needs. tests/dcbench.py arms a breakpoint on each
+; cell and reads MartyPC's cycle counter at every hit: the gap between two
+; consecutive hits on one cell is one whole call, so the two gaps' difference
+; IS what the content cell costs over the screen cell.
+;
+; Built twice: with DCB_CREL the header carries PKGF_CREL and wm_pkgcall sets
+; the drawing context around every callback; without it, it does not and the
+; content cells are not called at all. The pair prices the per-callback DC
+; setup (`dcbench.py` times wm_pkgcall to the package's dispatcher).
+; =============================================================================
+
+%include "os88api.inc"
+
+%ifdef DCB_CREL
+    OS88_HEADER 'DCBENCH', db_entry, PKGF_CREL
+%else
+    OS88_HEADER 'DCBENCHS', db_entry
+%endif
+
+DB_X        equ 16              ; the content point everything is drawn at
+DB_Y        equ 16
+
+db_entry:
+    push si
+    mov si, db_tpl
+    call OSAPI_WM_CREATE
+    jc .out
+    OS88_REGION_MOVABLE
+.out:
+    pop si
+    ret
+
+; -----------------------------------------------------------------------------
+; db_paint - W_PAINT. SI = window. The drawing is the measurement.
+; -----------------------------------------------------------------------------
+db_paint:
+    mov bx, si
+    call OSAPI_WM_CONTENT       ; AX = ox, DX = oy (the rig leaves it screen)
+    mov [db_ox], ax
+    mov [db_oy], dx
+    mov al, CBLACK
+    call OSAPI_SET_COLOR
+%ifdef DCB_CREL
+    ; --- FILL: 8 x 8 at (16,16), eight times each ---------------------------
+    mov ax, [db_ox]
+    add ax, DB_X
+    mov bx, [db_oy]
+    add bx, DB_Y
+    mov cx, ax
+    add cx, 7
+    mov dx, bx
+    add dx, 7
+    call OSAPI_GFX_FILL
+    call OSAPI_GFX_FILL
+    call OSAPI_GFX_FILL
+    call OSAPI_GFX_FILL
+    call OSAPI_GFX_FILL
+    call OSAPI_GFX_FILL
+    call OSAPI_GFX_FILL
+    call OSAPI_GFX_FILL
+    mov ax, DB_X
+    mov bx, DB_Y
+    mov cx, DB_X + 7
+    mov dx, DB_Y + 7
+    call OSAPI_CGFX_FILL
+    call OSAPI_CGFX_FILL
+    call OSAPI_CGFX_FILL
+    call OSAPI_CGFX_FILL
+    call OSAPI_CGFX_FILL
+    call OSAPI_CGFX_FILL
+    call OSAPI_CGFX_FILL
+    call OSAPI_CGFX_FILL
+    ; --- HLINE: 64 px at y = 30, eight times each ----------------------------
+    mov ax, [db_ox]
+    add ax, DB_X
+    mov bx, ax
+    add bx, 63
+    mov dx, [db_oy]
+    add dx, 30
+    call OSAPI_GFX_HLINE
+    call OSAPI_GFX_HLINE
+    call OSAPI_GFX_HLINE
+    call OSAPI_GFX_HLINE
+    call OSAPI_GFX_HLINE
+    call OSAPI_GFX_HLINE
+    call OSAPI_GFX_HLINE
+    call OSAPI_GFX_HLINE
+    mov ax, DB_X
+    mov bx, DB_X + 63
+    mov dx, 30
+    call OSAPI_CGFX_HLINE
+    call OSAPI_CGFX_HLINE
+    call OSAPI_CGFX_HLINE
+    call OSAPI_CGFX_HLINE
+    call OSAPI_CGFX_HLINE
+    call OSAPI_CGFX_HLINE
+    call OSAPI_CGFX_HLINE
+    call OSAPI_CGFX_HLINE
+    ; --- FONT_RUN: eight cells at (16,40), four times each -------------------
+    mov cx, [db_ox]
+    add cx, DB_X
+    mov dx, [db_oy]
+    add dx, 40
+    mov si, db_s8
+    mov ax, (CWHITE << 8) | CBLACK
+    call OSAPI_FONT_RUN
+    call OSAPI_FONT_RUN
+    call OSAPI_FONT_RUN
+    call OSAPI_FONT_RUN
+    mov cx, DB_X
+    mov dx, 40
+    call OSAPI_CFONT_RUN
+    call OSAPI_CFONT_RUN
+    call OSAPI_CFONT_RUN
+    call OSAPI_CFONT_RUN
+    ; --- BLIT1: a 16 x 8 band at (16,56), four times each --------------------
+    push ds
+    pop es
+    mov si, db_band
+    mov bp, 2
+    mov ax, [db_ox]
+    add ax, DB_X
+    mov bx, [db_oy]
+    add bx, 56
+    mov cx, 16
+    mov dx, 8
+    call OSAPI_GFX_BLIT1
+    call OSAPI_GFX_BLIT1
+    call OSAPI_GFX_BLIT1
+    call OSAPI_GFX_BLIT1
+    mov ax, DB_X
+    mov bx, 56
+    call OSAPI_CGFX_BLIT1
+    call OSAPI_CGFX_BLIT1
+    call OSAPI_CGFX_BLIT1
+    call OSAPI_CGFX_BLIT1
+    ; --- FONT_CHAR_XPARENT: one glyph at (16,72), eight times each ----------
+    mov cx, [db_ox]
+    add cx, DB_X
+    mov dx, [db_oy]
+    add dx, 72
+    mov al, 'W'
+    call OSAPI_FONT_CHAR_XPARENT
+    call OSAPI_FONT_CHAR_XPARENT
+    call OSAPI_FONT_CHAR_XPARENT
+    call OSAPI_FONT_CHAR_XPARENT
+    call OSAPI_FONT_CHAR_XPARENT
+    call OSAPI_FONT_CHAR_XPARENT
+    call OSAPI_FONT_CHAR_XPARENT
+    call OSAPI_FONT_CHAR_XPARENT
+    mov cx, DB_X
+    mov dx, 72
+    call OSAPI_CFONT_CHAR_XPARENT
+    call OSAPI_CFONT_CHAR_XPARENT
+    call OSAPI_CFONT_CHAR_XPARENT
+    call OSAPI_CFONT_CHAR_XPARENT
+    call OSAPI_CFONT_CHAR_XPARENT
+    call OSAPI_CFONT_CHAR_XPARENT
+    call OSAPI_CFONT_CHAR_XPARENT
+    call OSAPI_CFONT_CHAR_XPARENT
+    ; --- FRAME: 40 x 20 at (100,16), eight times each -----------------------
+    mov ax, [db_ox]
+    add ax, 100
+    mov bx, [db_oy]
+    add bx, 16
+    mov cx, ax
+    add cx, 39
+    mov dx, bx
+    add dx, 19
+    call OSAPI_GFX_FRAME
+    call OSAPI_GFX_FRAME
+    call OSAPI_GFX_FRAME
+    call OSAPI_GFX_FRAME
+    call OSAPI_GFX_FRAME
+    call OSAPI_GFX_FRAME
+    call OSAPI_GFX_FRAME
+    call OSAPI_GFX_FRAME
+    mov ax, 100
+    mov bx, 16
+    mov cx, 139
+    mov dx, 35
+    call OSAPI_CGFX_FRAME
+    call OSAPI_CGFX_FRAME
+    call OSAPI_CGFX_FRAME
+    call OSAPI_CGFX_FRAME
+    call OSAPI_CGFX_FRAME
+    call OSAPI_CGFX_FRAME
+    call OSAPI_CGFX_FRAME
+    call OSAPI_CGFX_FRAME
+    ; --- ...and the CUT cases, once each, for the record ---------------------
+    mov ax, -4                  ; a fill hanging 4 px off the content's left
+    mov bx, DB_Y + 80
+    mov cx, 11
+    mov dx, DB_Y + 87
+    call OSAPI_CGFX_FILL
+    mov cx, -12                 ; a run starting 12 px off the content's left
+    mov dx, 120
+    mov si, db_s8
+    mov ax, (CWHITE << 8) | CBLACK
+    call OSAPI_CFONT_RUN
+    ; --- ...and the SAME two spills through the SCREEN cells, 30 rows down,
+    ; which is what a package that got its arithmetic wrong does today ------
+    mov ax, [db_ox]
+    sub ax, 4
+    mov bx, [db_oy]
+    add bx, DB_Y + 110
+    mov cx, ax
+    add cx, 15
+    mov dx, bx
+    add dx, 7
+    call OSAPI_GFX_FILL
+    mov cx, [db_ox]
+    sub cx, 12
+    mov dx, [db_oy]
+    add dx, 150
+    mov si, db_s8
+    mov ax, (CWHITE << 8) | CBLACK
+    call OSAPI_FONT_RUN
+%endif
+    ret
+
+db_tpl:
+    dw 120, 120, 320, 180
+    dw db_ttl, db_paint, 0, 0
+db_ttl:     db 'DCBench', 0
+db_s8:      db 'ABCDEFGH', 0
+db_band:    times 8 db 0xAA, 0x55
+
+    OS88_BSS 4
+    OS88_IMAGE_END
+
+db_ox       equ os88_image_end + 0
+db_oy       equ os88_image_end + 2
