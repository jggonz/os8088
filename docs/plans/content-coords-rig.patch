index 00000000..92f0a8f3
--- /dev/null
+++ b/tests/dcrig/dcksec.py
@@ -0,0 +1,39 @@
+"""Section sizes of kern_big / kern_small / kern_emu, stock against the DCPROTO rig.
+
+Re-assembles kernel/kernel.asm with -DKERNSIZE (kernsize.py's own `ks:` line)
+for each variant. Generated includes come from build/ (big), build/smallk/
+(small) and build/emuk/ (emu) when present.
+"""
+import os, re, subprocess, sys, tempfile
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+VAR = {"big": (["-DKERN_BIG"], "build"),
+       "small": (["-DKERN_SMALL"], "build/smallk"),
+       "emu": (["-DKERN_BIG", "-DKERN_EMU"], "build/emuk")}
+
+def ks(defs, bdir):
+    fd, out = tempfile.mkstemp(suffix=".bin", dir=os.path.join(ROOT, "build", "proto"))
+    os.close(fd)
+    b = os.path.join(ROOT, bdir)
+    if not os.path.isdir(b):
+        b = os.path.join(ROOT, "build")
+    cmd = ["nasm", "-f", "bin", "-w+error", "-w-error=user", "-DKERNSIZE",
+           "-I", "kernel/", "-I", "apps/", "-I", b + "/", *defs,
+           "-DKZIP", "-DKZ_SECS=0", "-DKZ_RPARA=0", "-DKZ_NBLK=1", "-DKZ_HEADSEC=9",
+           "-o", out, "kernel/kernel.asm"]
+    r = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)
+    os.unlink(out)
+    if r.returncode:
+        return None, r.stderr.strip().splitlines()[-3:]
+    m = re.search(r"\bks: (.*?)(?: \[|$)", r.stderr, re.M)
+    return dict((k, int(v)) for k, _, v in (p.partition("=") for p in m.group(1).split())), None
+
+for name, (defs, bdir) in VAR.items():
+    a, ea = ks(defs, bdir)
+    b, eb = ks(defs + ["-DDCPROTO"], bdir)
+    if ea or eb:
+        print(name, "FAILED", ea, eb)
+        continue
+    keys = [k for k in a if a[k] != b.get(k)]
+    print("%-6s %s" % (name, "  ".join("%s %d->%d (%+d)" % (k, a[k], b[k], b[k] - a[k]) for k in keys)))
+    if len(sys.argv) > 1:
+        print("       stock:", a)
diff --git a/tests/dcrig/dcorigest.py b/tests/dcrig/dcorigest.py
new file mode 100644
index 00000000..83ef69ed
--- /dev/null
+++ b/tests/dcrig/dcorigest.py
@@ -0,0 +1,67 @@
+"""Estimate the origin arithmetic in every package (CONTENT-COORDS-PLAN 3.1).
+
+For each package: the WM_CONTENT/WM_GEOM call sites, the memory words the
+content origin is banked into (the first `mov [X], ax` / `mov [X], dx` within
+eight lines after a WM_CONTENT call), and every OTHER instruction that names
+one of those words - each an `add/sub/mov reg, [X]` of 4 bytes (3 for the
+accumulator's `mov ax, [X]`, 5 with a segment prefix).
+"""
+import os, re, sys, collections
+root = sys.argv[1]
+call = re.compile(r"^\s*(?:[\w.]+:\s*)?call\s+(?:far\s+)?OSAPI_(WM_CONTENT|WM_GEOM)\b")
+store = re.compile(r"^\s*mov\s+(?:word\s+)?\[(?:cs:|ds:)?\s*([A-Za-z_][\w.]*)\s*\]\s*,\s*(ax|dx)\b", re.I)
+
+def files(p):
+    if os.path.isdir(p):
+        for dp, dn, fn in os.walk(p):
+            for f in fn:
+                if f.endswith(('.asm', '.inc')):
+                    yield os.path.join(dp, f)
+    else:
+        yield p
+
+tot = collections.Counter()
+rows = []
+for base in ['apps', 'drivers', 'tests']:
+    for e in sorted(os.listdir(os.path.join(root, base))):
+        p = os.path.join(root, base, e)
+        if not (os.path.isdir(p) or e.endswith('.inc')):
+            continue
+        texts = {}
+        for f in files(p):
+            texts[f] = [re.sub(r";.*", "", l) for l in open(f, errors='replace').read().split('\n')]
+        ncont = ngeom = 0
+        orig = set()
+        for f, ls in texts.items():
+            for i, l in enumerate(ls):
+                m = call.match(l)
+                if not m:
+                    continue
+                if m.group(1) == 'WM_CONTENT':
+                    ncont += 1
+                    for j in range(i + 1, min(i + 9, len(ls))):
+                        if re.match(r"^\s*(?:[\w.]+:\s*)?(call|ret|jmp)\b", ls[j]):
+                            break
+                        s = store.match(ls[j])
+                        if s:
+                            orig.add(s.group(1))
+                else:
+                    ngeom += 1
+        refs = 0; byt = 0
+        if orig:
+            pat = re.compile(r"\[(?:cs:|ds:|es:)?\s*(%s)\s*(?:[+-][^\]]*)?\]" % "|".join(map(re.escape, orig)))
+            for f, ls in texts.items():
+                for l in ls:
+                    if pat.search(l) and not store.match(l):
+                        refs += 1
+                        byt += 3 if re.match(r"^\s*mov\s+ax\s*,", l) else (5 if re.search(r"\[(cs|es):", l) else 4)
+        if ncont or ngeom:
+            # a WM_CONTENT site: `mov bx, si` 2 + call 5 = 7; the two stores 7
+            site = ncont * 7 + ngeom * 5 + len(orig) * 3
+            rows.append((base + '/' + e, ncont, ngeom, ','.join(sorted(orig))[:40], refs, byt, site))
+            tot[base + 'refs'] += refs; tot[base + 'b'] += byt; tot[base + 'site'] += site
+            tot[base + 'n'] += 1
+for r in rows:
+    print("%-26s content %2d geom %2d  vars %-40s refs %4d ~%5d B  sites ~%4d B" % r)
+for b in ['apps', 'drivers', 'tests']:
+    print(b, tot[b + 'n'], 'packages, refs', tot[b + 'refs'], 'ref bytes', tot[b + 'b'], 'site bytes', tot[b + 'site'])
