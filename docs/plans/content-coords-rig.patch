diff --git a/kernel/dcproto.inc b/kernel/dcproto.inc
new file mode 100644
index 00000000..28122b4c
--- /dev/null
+++ b/kernel/dcproto.inc
@@ -0,0 +1,503 @@
+; =============================================================================
+; os8088 - dcproto.inc
+;
+; PROTOTYPE ONLY - docs/plans/CONTENT-COORDS-PLAN.md's measuring rig. Never
+; built by default: everything here is inside %ifdef DCPROTO, and nothing that
+; ships defines it. It exists so the plan's cycle and byte figures are
+; MEASURED against a real body rather than counted off a listing.
+;
+; THE DRAWING CONTEXT (DC). Four words: the content origin of the window whose
+; callback is running, and its content box's last column and row in CONTENT
+; coordinates. wm_pkgcall sets them for a package whose header carries
+; PKGF_CREL and stacks the caller's around the callback; the CONTENT cells
+; below read them. The SCREEN cells are untouched, and so is every kernel
+; caller, which reaches the primitives by near call and never meets a cell.
+; =============================================================================
+
+%ifdef DCPROTO
+section .text
+
+
+dc_ox       dw 0                ; .text WITH initialisers: read by the first
+dc_oy       dw 0                ; content cell a package ever calls, which can
+dc_w1       dw 0x7FFF           ; be from its entry proc before any callback
+dc_h1       dw 0x7FFF           ; has set them
+dc_tgt      dw 0                ; the blit shape's target (BP is an INPUT there)
+dc_tw       dw 0                ; the text shape's run width
+
+; -----------------------------------------------------------------------------
+; dc_set - the DC := window SI's content box
+; in:  SI = window record (KERNEL_SEG). DS anything.
+; out: nothing; every register and DS preserved, flags clobbered
+; -----------------------------------------------------------------------------
+dc_set:
+    push ds
+    push cs
+    pop ds
+    push ax
+    push bx
+    push cx
+    push dx
+    mov bx, si
+    call wm_content             ; AX = content left, DX = top
+    mov [dc_ox], ax
+    mov [dc_oy], dx
+    call wm_geom                ; CX = width, DX = height
+    dec cx
+    mov [dc_w1], cx
+    dec dx
+    mov [dc_h1], dx
+    pop dx
+    pop cx
+    pop bx
+    pop ax
+    pop ds
+    ret
+
+; -----------------------------------------------------------------------------
+; dc_ptxl - a click's CX/DX into window SI's content coordinates, IF its owner
+;           asked for them (header PKGF_CREL). DS = KERNEL_SEG.
+; -----------------------------------------------------------------------------
+dc_ptxl:
+    cmp word [si+W_SEG], 0
+    je .out
+    push es
+    mov es, [si+W_SEG]
+    test byte [es:3], PKGF_CREL
+    pop es
+    jz .out
+    push ax
+    push bx
+    push dx
+    mov bx, si
+    call wm_content             ; AX = ox, DX = oy
+    sub cx, ax
+    mov ax, dx
+    pop dx
+    sub dx, ax
+    pop bx
+    pop ax
+.out:
+    ret
+
+; -----------------------------------------------------------------------------
+; THE CONTENT CELLS' SHAPES. A cell is `push bp / mov bp, target / jmp shape`
+; (OSAPI_XCELL's seven bytes); the shape switches DS, cuts the arguments to the
+; content box, adds the origin, calls the target, restores and retf's.
+; -----------------------------------------------------------------------------
+
+; RECT: AX = x1, BX = y1, CX = x2, DX = y2 - clipped exactly to the box
+dcs_rect:
+    push ds
+    push cs
+    pop ds
+    push ax
+    push bx
+    push cx
+    push dx
+    or ax, ax
+    js .fa
+.ra:
+    or bx, bx
+    js .fb
+.rb:
+    cmp cx, [dc_w1]
+    jg .fc
+.rc:
+    cmp dx, [dc_h1]
+    jg .fd
+.rd:
+    cmp ax, cx
+    jg dcs_rect.o4
+    cmp bx, dx
+    jg dcs_rect.o4
+    add ax, [dc_ox]
+    add cx, [dc_ox]
+    add bx, [dc_oy]
+    add dx, [dc_oy]
+    call bp
+.o4:
+    pop dx
+    pop cx
+    pop bx
+    pop ax
+    pop ds
+    pop bp
+    retf
+.fa:
+    xor ax, ax
+    jmp short .ra
+.fb:
+    xor bx, bx
+    jmp short .rb
+.fc:
+    mov cx, [dc_w1]
+    jmp short .rc
+.fd:
+    mov dx, [dc_h1]
+    jmp short .rd
+
+; HLINE: AX = x1, BX = x2, DX = y
+dcs_hline:
+    push ds
+    push cs
+    pop ds
+    push ax
+    push bx
+    push cx
+    push dx
+    cmp dx, [dc_h1]
+    ja dcs_rect.o4                 ; unsigned: above the box OR below it
+    or ax, ax
+    js .fa
+.ra:
+    cmp bx, [dc_w1]
+    jg .fb
+.rb:
+    cmp ax, bx
+    jg dcs_rect.o4
+    add ax, [dc_ox]
+    add bx, [dc_ox]
+    add dx, [dc_oy]
+    call bp
+    jmp short dcs_rect.o4
+.fa:
+    xor ax, ax
+    jmp short .ra
+.fb:
+    mov bx, [dc_w1]
+    jmp short .rb
+
+; VLINE: AX = x, BX = y1, DX = y2
+dcs_vline:
+    push ds
+    push cs
+    pop ds
+    push ax
+    push bx
+    push cx
+    push dx
+    cmp ax, [dc_w1]
+    ja dcs_rect.o4
+    or bx, bx
+    js .fa
+.ra:
+    cmp dx, [dc_h1]
+    jg .fb
+.rb:
+    cmp bx, dx
+    jg dcs_rect.o4
+    add ax, [dc_ox]
+    add bx, [dc_oy]
+    add dx, [dc_oy]
+    call bp
+    jmp short dcs_rect.o4
+.fa:
+    xor bx, bx
+    jmp short .ra
+.fb:
+    mov dx, [dc_h1]
+    jmp short .rb
+
+; TEXT: CX = x, DX = y, the rest the target's. A run's extent is the target's
+; to measure, so the box is ARMED as a one-fragment region when nothing is,
+; and the target's own region test cuts the run (whole cells, SPEC.md 11.3).
+; dcs_txt keeps the caller's ES (a SLOT target); dcs_txtx is api_x's shape,
+; ES = the caller's DS for an X target.
+dcs_txt:                        ; font_char: one 8 x 8 cell
+    push ds
+    push cs
+    pop ds
+    mov word [dc_tw], 8
+    call dcs_tcore
+    pop ds
+    pop bp
+    retf
+dcs_txtx:                       ; font_str / font_run: a NUL string at DS:SI
+    push ds
+    push es
+    push ds
+    pop es                      ; ES:SI = the caller's string (api_x's shape)
+    push cs
+    pop ds
+    push ax
+    push cx
+    push di
+    mov di, si
+    xor al, al
+    mov cx, 0FFFFh
+    repne scasb                 ; DF = 0 is the contract (SPEC.md 1)
+    not cx
+    dec cx                      ; CX = the string's length
+    shl cx, 1
+    shl cx, 1
+    shl cx, 1
+    mov [dc_tw], cx             ; ...its extent in pixels
+    pop di
+    pop cx
+    pop ax
+    call dcs_tcore
+dcs_txend:
+    pop es
+    pop ds
+    pop bp
+    retf
+dcs_ico:                        ; an icon record: no extent to hand, so armed
+    push ds
+    push es
+    push ds
+    pop es
+    push cs
+    pop ds
+    mov word [dc_tw], 0FFFFh
+    call dcs_tcore
+    jmp short dcs_txend
+; dcs_tcore - CX/DX content, [dc_tw] the run's width. WHOLLY INSIDE the box
+; (the case every in-box caller is): translated and drawn, nothing armed.
+; Straddling: the box armed as a one-fragment region for the call, so the
+; target's own whole-cell test cuts it.
+dcs_tcore:
+    push cx
+    push dx
+    or cx, cx
+    js .cut
+    or dx, dx
+    js .cut
+    push cx
+    add cx, [dc_tw]
+    jc .cutp                    ; (an icon's 0FFFFh, or a wrap)
+    dec cx
+    cmp cx, [dc_w1]
+    pop cx
+    jg .cut
+    push dx
+    add dx, 7
+    cmp dx, [dc_h1]
+    pop dx
+    jg .cut
+    add cx, [dc_ox]
+    add dx, [dc_oy]
+    call bp
+    pop dx
+    pop cx
+    ret
+.cutp:
+    pop cx
+.cut:
+    add cx, [dc_ox]
+    add dx, [dc_oy]
+    cmp word [wm_clip_n], 0
+    jne .armed
+    call dc_arm
+    call bp
+    mov word [wm_clip_n], 0     ; MOV writes no flags: the target's CF rides
+    pop dx
+    pop cx
+    ret
+.armed:
+    call bp
+    pop dx
+    pop cx
+    ret
+
+; dc_arm - wm_clip_tab := the DC's box, one fragment, and the deferred
+; cursor hide spent (an armed region skips GFXCLIP's own). Every register
+; preserved.
+dc_arm:
+    call cur_unlazy
+    push ax
+    mov ax, [dc_ox]
+    mov [wm_clip_tab+WCR_X1], ax
+    add ax, [dc_w1]
+    mov [wm_clip_tab+WCR_X2], ax
+    mov ax, [dc_oy]
+    mov [wm_clip_tab+WCR_Y1], ax
+    add ax, [dc_h1]
+    mov [wm_clip_tab+WCR_Y2], ax
+    mov word [wm_clip_n], 1
+    pop ax
+    ret
+
+; BLIT: AX = x, BX = y, CX = w, DX = h, BP = stride, ES:SI = the source - the
+; cell is `push bp / call dcs_blit / dw target` (six bytes), because BP is an
+; input. Wholly inside the box: drawn as given. Straddling: the box armed for
+; the call, exactly as the text shape does.
+dcs_blit:                       ; STKBALANCE-OK: pops the cell's return address - it IS the target word's address
+    pop bp
+    push ax
+    mov ax, [cs:bp]
+    mov [cs:dc_tgt], ax
+    pop ax
+    pop bp                      ; the caller's BP: the stride
+    push ds
+    push cs
+    pop ds
+    push ax
+    push bx
+    or ax, ax
+    js .cut
+    or bx, bx
+    js .cut
+    push ax
+    add ax, cx
+    dec ax
+    cmp ax, [dc_w1]
+    pop ax
+    jg .cut
+    push bx
+    add bx, dx
+    dec bx
+    cmp bx, [dc_h1]
+    pop bx
+    jg .cut
+    add ax, [dc_ox]
+    add bx, [dc_oy]
+    call word [dc_tgt]
+    jmp short .out
+.cut:
+    add ax, [dc_ox]
+    add bx, [dc_oy]
+    cmp word [wm_clip_n], 0
+    jne .armed
+    call dc_arm
+    call word [dc_tgt]
+    mov word [wm_clip_n], 0
+    jmp short .out
+.armed:
+    call word [dc_tgt]
+.out:
+    pop bx
+    pop ax
+    pop ds
+    retf
+
+
+; PIXEL: CX = x, DX = y
+dcs_pt:
+    push ds
+    push cs
+    pop ds
+    push ax
+    push bx
+    push cx
+    push dx
+    cmp cx, [dc_w1]
+    ja dcs_rect.o4
+    cmp dx, [dc_h1]
+    ja dcs_rect.o4
+    add cx, [dc_ox]
+    add dx, [dc_oy]
+    call bp
+    jmp dcs_rect.o4
+
+; RECT, X-type (the target reads caller data through ES): ES = caller's DS
+dcs_rectx:
+    push ds
+    push es
+    push ds
+    pop es
+    push cs
+    pop ds
+    push ax
+    push bx
+    push cx
+    push dx
+    or ax, ax
+    jns .a
+    xor ax, ax
+.a: or bx, bx
+    jns .b
+    xor bx, bx
+.b: cmp cx, [dc_w1]
+    jle .c
+    mov cx, [dc_w1]
+.c: cmp dx, [dc_h1]
+    jle .d
+    mov dx, [dc_h1]
+.d: cmp ax, cx
+    jg .none
+    cmp bx, dx
+    jg .none
+    add ax, [dc_ox]
+    add cx, [dc_ox]
+    add bx, [dc_oy]
+    add dx, [dc_oy]
+    call bp
+.none:
+    pop dx
+    pop cx
+    pop bx
+    pop ax
+    pop es
+    pop ds
+    pop bp
+    retf
+
+; RECT, TRANSLATED ONLY - a rect that is a QUESTION or a buffer's shape
+; (CLIP_TEST, SAVE, REST): cutting it would change the answer or the layout
+dcs_rectt:
+    push ds
+    push cs
+    pop ds
+    push ax
+    push bx
+    push cx
+    push dx
+    add ax, [dc_ox]
+    add cx, [dc_ox]
+    add bx, [dc_oy]
+    add dx, [dc_oy]
+    call bp
+    jmp dcs_rect.o4
+
+; RECT OUT (WM_DAMAGE): the answer comes back in content coordinates
+dcs_rout:
+    push ds
+    push cs
+    pop ds
+    call bp
+    pushf
+    sub ax, [dc_ox]
+    sub cx, [dc_ox]
+    sub bx, [dc_oy]
+    sub dx, [dc_oy]
+    popf
+    pop ds
+    pop bp
+    retf
+
+; POINT OUT (MOUSE): CX/DX back relative to the DC's origin
+dcs_pout:
+    push ds
+    push cs
+    pop ds
+    call bp
+    pushf
+    sub cx, [dc_ox]
+    sub dx, [dc_oy]
+    popf
+    pop ds
+    pop bp
+    retf
+
+
+; SELECT (WM_CLIP_SET): the region is armed for window BX and, if anything of
+; it shows, the DC becomes BX's - what a WORKER needs, having no dispatch to
+; set one. CF is the answer, as the screen cell's.
+dcs_sel:
+    push ds
+    push cs
+    pop ds
+    call bp
+    jc .out
+    push si
+    mov si, bx
+    call dc_set
+    pop si
+    clc
+.out:
+    pop ds
+    pop bp
+    retf
+
+%endif ; DCPROTO
diff --git a/kernel/kernel.asm b/kernel/kernel.asm
index 85e3129c..c8365da8 100644
--- a/kernel/kernel.asm
+++ b/kernel/kernel.asm
@@ -1450,6 +1450,19 @@ dbg_reg_at:                     ; 0060:000E - THE DEBUG REGISTRY (SPEC.md 57)
     call COLD_SEG:%1
     retf
 %endmacro
+%ifdef DCPROTO                      ; docs/plans/CONTENT-COORDS-PLAN.md's rig
+PKGF_CREL   equ 0x40
+%macro OSAPI_DCELL 2                ; 7 bytes: a content cell
+    push bp
+    mov bp, %1
+    jmp strict near %2
+%endmacro
+%macro OSAPI_DBCELL 1               ; 6 bytes: a content BLIT cell
+    push bp
+    call dcs_blit
+    dw %1
+%endmacro
+%endif
 
 ; ---- the INLINE cells (SPEC.md 20.3): THE CELL IS THE ROUTINE ---------------
 ; Fifteen routines were ONE memory access and a `ret` - a getter, a setter or
@@ -3006,6 +3019,34 @@ apic_inst_minimize:               ; DOCK.DRV's door (SPEC.md 30.4)
                                   ;          size once, at the close or when
                                   ;          the UI unlocks. kern_big; the
                                   ;          small door refuses
+%ifdef DCPROTO
+    OSAPI_DCELL gfx_hline, dcs_hline     ; 0x0467 CONTENT cells (the rig)
+    OSAPI_DCELL gfx_vline, dcs_vline     ; 0x046E
+    OSAPI_DCELL gfx_fill, dcs_rect       ; 0x0475
+    OSAPI_DCELL gfx_frame, dcs_rect      ; 0x047C
+    OSAPI_DCELL gfx_fill_gray, dcs_rect  ; 0x0483
+    OSAPI_DCELL gfx_xor_rect, dcs_rect   ; 0x048A
+    OSAPI_DCELL gfx_xor_fill, dcs_rect   ; 0x0491
+    OSAPI_DCELL font_char, dcs_txt       ; 0x0498
+    OSAPI_DCELL font_str_x, dcs_txtx     ; 0x049F
+    OSAPI_DCELL font_run_x, dcs_txtx     ; 0x04A6
+    OSAPI_DBCELL gfx_blit1               ; 0x04AD
+    OSAPI_DBCELL gfx_blit4               ; 0x04B3
+    OSAPI_DCELL gfx_pixel, dcs_pt        ; 0x04B9
+    OSAPI_DCELL osapi_gfx_fill_pat, dcs_rectx ; 0x04C0
+    OSAPI_DCELL gfx_scroll, dcs_rect     ; 0x04C7
+    OSAPI_DCELL icon_draw_x, dcs_ico     ; 0x04CE
+    OSAPI_DCELL api_gfx_save, dcs_rectt  ; 0x04D5
