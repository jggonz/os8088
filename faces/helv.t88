# faces/helv.t88 - Helvetica, fitted to SPEC.md 6.4's 8-pixel grid
#
# Arimo is the Arial/Helvetica width model, drawn at 500 rather than 400 so
# that the stems land on 2 pixels more often than not. Named for the base-14
# face it stands in for, which is what the psname line is: a document set in
# it can be printed in the real thing (SPEC.md 6.4).
#
# SOURCE   Arimo.ttf
#          https://raw.githubusercontent.com/google/fonts/main/ofl/arimo/Arimo[wght].ttf
# LICENCE  SIL Open Font License 1.1 - see faces/LICENSES.txt
# SHA-256  e43898b143ec826ac8cb4034816458a7047fbe0836558de2a1f8c6223ae3e0ca
# DRAFTED  python3 tools/os88ttf.py Arimo.ttf --name Helvetica --psname Helvetica --ppem 11 --rows 12 --ascent 9 --leading 2 --gap 1 --wght 500.0 -o faces/helv.t88
#
# HAND-FIT  73 'I' - serifed, so a grotesque's capital I is not pixel-
#           identical to its lowercase l in a file name (SPEC.md 6.4.1)
#
# THE ART IS THE SOURCE from here on. The line above reproduces
# the first draft, not this file: a glyph the 8-pixel grid could
# not take from the outline is hand-fitted here, which is how a
# bitmap face has always been made (SPEC.md 6.2).

face Helvetica
rows 12
ascent 9
leading 2
aspect 0

style regular
psname Helvetica

