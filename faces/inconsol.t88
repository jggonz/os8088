# faces/inconsol.t88 - Inconsolata, fitted to SPEC.md 6.4's 8-pixel grid
#
# The narrow monospace - SIX pixels an advance, so 106 columns fit across a
# 640-pixel screen against Courier's 80, in a 12-row cell that leaves Word's
# row pitch exactly where the 8x8 face left it.
#
# SOURCE   Inconsolata.ttf
#          https://raw.githubusercontent.com/google/fonts/main/ofl/inconsolata/Inconsolata[wdth,wght].ttf
# LICENCE  SIL Open Font License 1.1 - see faces/LICENSES.txt
# SHA-256  23ded25b447074d00659392bf9b1123d89df55cb07b0ad9bfef3366d199b5fcb
# DRAFTED  python3 tools/os88ttf.py Inconsolata.ttf --name Inconsolata --psname Courier --ppem 12 --rows 12 --ascent 9 --fixed 6 --gap 1 --wght 600.0 -o faces/inconsol.t88
#
# THE ART IS THE SOURCE from here on. The line above reproduces
# the first draft, not this file: a glyph the 8-pixel grid could
# not take from the outline is hand-fitted here, which is how a
# bitmap face has always been made (SPEC.md 6.2).

face Inconsolata
rows 12
ascent 9
leading 0
aspect 0

style regular
psname Courier

