# faces/archivo.t88 - Archivo Narrow, fitted to SPEC.md 6.4's 8-pixel grid
#
# A narrow grotesque, drawn narrow rather than squeezed: most of its letters
# are 4 or 6 pixels wide, so a line of it fits about a fifth more text than
# Helv does at the same cap height.
#
# SOURCE   ArchivoNarrow.ttf
#          https://raw.githubusercontent.com/google/fonts/main/ofl/archivonarrow/ArchivoNarrow[wght].ttf
# LICENCE  SIL Open Font License 1.1 - see faces/LICENSES.txt
# SHA-256  adbe027f625c8393ae0f6e174e32e233dda485bc3eda5153ce428275394ef97f
# DRAFTED  python3 tools/os88ttf.py ArchivoNarrow.ttf --name 'Archivo Narrow' --psname Helvetica --ppem 11 --rows 12 --ascent 9 --leading 2 --gap 1 --wght 700.0 -o faces/archivo.t88
#
# HAND-FIT  33 '!' - the hinter drew it as a solid stem, pixel-identical to
#           'I' and 'l'; the dot's gap is drawn in. 73 'I' - serifed, so a
#           bare stem in a file name is not its own lowercase (SPEC.md 6.4.1)
#
# THE ART IS THE SOURCE from here on. The line above reproduces
# the first draft, not this file: a glyph the 8-pixel grid could
# not take from the outline is hand-fitted here, which is how a
# bitmap face has always been made (SPEC.md 6.2).

face Archivo Narrow
rows 12
ascent 9
leading 2
aspect 0

style regular
psname Helvetica

