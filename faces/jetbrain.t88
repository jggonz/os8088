# faces/jetbrain.t88 - JetBrains Mono, fitted to SPEC.md 6.4's 8-pixel grid
#
# The reading monospace: an x-height of 7 rows in a cell of 14, which is the
# largest lowercase of anything in FONTS/, and 700 weight so that every stem
# is 2 pixels. This is the face to put a long listing in.
#
# SOURCE   JetBrainsMono.ttf
#          https://raw.githubusercontent.com/google/fonts/main/ofl/jetbrainsmono/JetBrainsMono[wght].ttf
# LICENCE  SIL Open Font License 1.1 - see faces/LICENSES.txt
# SHA-256  48715a42ec242c21e9f02692891e147d022299a52e48d5e413e1a942193ffeda
# DRAFTED  python3 tools/os88ttf.py JetBrainsMono.ttf --name 'JetBrains Mono' --psname Courier --ppem 13 --rows 14 --ascent 11 --fixed 8 --gap 1 --wght 700.0 -o faces/jetbrain.t88
#
# THE ART IS THE SOURCE from here on. The line above reproduces
# the first draft, not this file: a glyph the 8-pixel grid could
# not take from the outline is hand-fitted here, which is how a
# bitmap face has always been made (SPEC.md 6.2).

face JetBrains Mono
rows 14
ascent 11
leading 0
aspect 0

style regular
psname Courier

