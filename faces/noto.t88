# faces/noto.t88 - Noto Serif, fitted to SPEC.md 6.4's 8-pixel grid
#
# The sturdy serif: Noto Serif's own CONDENSED master at 62.5% width and 700
# weight, which is the honest way to reach an 8-pixel cell - the designer's
# narrow drawing rather than this tool's column merge. It is the face to
# read a document in on a 1bpp adapter.
#
# SOURCE   NotoSerif.ttf
#          https://raw.githubusercontent.com/google/fonts/main/ofl/notoserif/NotoSerif[wdth,wght].ttf
# LICENCE  SIL Open Font License 1.1 - see faces/LICENSES.txt
# SHA-256  4d8e6761424656867019081a1a01336f3cb086982682698714054fc33f782713
# DRAFTED  python3 tools/os88ttf.py NotoSerif.ttf --name 'Noto Serif' --psname Times-Roman --ppem 11 --rows 12 --ascent 9 --leading 2 --gap 1 --wght 700.0 --wdth 62.5 -o faces/noto.t88
#
# THE ART IS THE SOURCE from here on. The line above reproduces
# the first draft, not this file: a glyph the 8-pixel grid could
# not take from the outline is hand-fitted here, which is how a
# bitmap face has always been made (SPEC.md 6.2).

face Noto Serif
rows 12
ascent 9
leading 2
aspect 0

style regular
psname Times-Roman

