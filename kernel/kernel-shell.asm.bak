; =============================================================================
; jop - kernel
;
; Runs in real mode, tiny model: CS = DS = ES = SS = KERNEL_SEG, so every
; label here is a plain 16-bit offset into our own 64KB segment. The stack
; lives at the top of that segment and grows down toward our data.
;
; Two fixed entry points, both promises we make to the outside world:
;   1000:0000  cold entry (the boot sector jumps here)
;   1000:0010  syscall entry (far call, function in AH) - see SYSCALL ABI below
; =============================================================================

bits 16
org 0x0000

KERNEL_SEG  equ 0x1000
GFX_SEG     equ 0x2000          ; reserved for the C graphics module
VGA_SEG     equ 0xA000          ; mode 13h framebuffer
STACK_TOP   equ 0xFFFE          ; top of our own segment

; -----------------------------------------------------------------------------
; SYSCALL ABI
;
;   far call 1000:0010 with the function number in AH.
;   Registers other than documented returns are preserved.
;
;   AH  function      in                          out
;   --  ------------  --------------------------  --------------------
;   00  putc          AL = char                   -
;   01  puts          ES:SI = far ptr to string    -
;   02  newline       -                           -
;   03  clear         -                           -
;   04  getkey        -                           AL = ascii, AH = scan
;   05  setmode       AL = BIOS video mode        -
;   06  putpixel      CX = x, DX = y, AL = color   -
;   07  memsize       -                           AX = KB conventional
;
; Strings are far pointers so a caller in another segment can pass its own
; data without us having to guess which segment it meant.
; -----------------------------------------------------------------------------
SYS_PUTC     equ 0x00
SYS_PUTS     equ 0x01
SYS_NEWLINE  equ 0x02
SYS_CLEAR    equ 0x03
SYS_GETKEY   equ 0x04
SYS_SETMODE  equ 0x05
SYS_PUTPIXEL equ 0x06
SYS_MEMSIZE  equ 0x07

; =============================================================================
; Fixed entry points
; =============================================================================
cold_entry:
    jmp kmain

    times 0x10 - ($ - $$) db 0  ; the syscall gate must land exactly at 0x0010

syscall_gate:
    jmp kernel_syscall

; =============================================================================
kmain:
    cli
    mov ax, KERNEL_SEG          ; the boot sector jumped here, but it did not
    mov ds, ax                  ; set up our segments - that is our own job
    mov es, ax
    mov ss, ax
    mov sp, STACK_TOP
    sti
    cld

    mov [boot_drive], dl

    call clear_screen

    mov si, msg_banner
    call puts
    mov si, msg_hint
    call puts

    ; fall through into the shell

; -----------------------------------------------------------------------------
; shell - read a line, match it against the command table, repeat forever
; -----------------------------------------------------------------------------
shell:
    mov si, msg_prompt
    call puts

    mov di, cmd_buf
    mov cx, CMD_BUF_LEN
    call readline

    mov si, cmd_buf
    call skip_spaces
    cmp byte [si], 0            ; bare enter: just prompt again
    je shell

    mov bx, cmd_table

.match:
    mov ax, [bx]                ; name pointer, 0 terminates the table
    test ax, ax
    jz .unknown

    push bx
    push si
    mov di, ax
    call strcmp
    pop si
    pop bx
    je .found

    add bx, 4                   ; each entry is {name ptr, handler ptr}
    jmp .match

.found:
    mov ax, [bx + 2]
    call ax
    jmp shell

.unknown:
    mov si, msg_unknown
    call puts
    mov si, cmd_buf
    call puts
    call newline
    jmp shell

; =============================================================================
; Command handlers
; =============================================================================
cmd_help:
    mov si, msg_help
    call puts
    ret

cmd_clear:
    call clear_screen
    ret

cmd_ver:
    mov si, msg_banner
    call puts
    ret

cmd_mem:
    mov si, msg_mem
    call puts
    int 0x12                    ; BIOS: AX = KB of conventional memory
    call print_dec
    mov si, msg_kb
    call puts
    ret

cmd_gfx:
    call gfx_demo
    ret

cmd_reboot:
    mov si, msg_reboot
    call puts
    mov cx, 0xFFFF              ; let the message land before we go
.wait:
    nop
    loop .wait
    int 0x19                    ; BIOS: restart the bootstrap loader
    ret

; =============================================================================
; Syscall dispatcher - reached by far call from another segment
; =============================================================================
; A compare chain rather than a jump table: with eight calls it is shorter,
; and it leaves the caller's registers alone so handlers can read their
; arguments straight out of them. Only DS is touched, and we restore it.
kernel_syscall:
    push ds
    push ax
    mov ax, KERNEL_SEG          ; our data, regardless of the caller's DS
    mov ds, ax
    pop ax

    cmp ah, SYS_PUTC
    je .putc
    cmp ah, SYS_PUTS
    je .puts
    cmp ah, SYS_NEWLINE
    je .newline
    cmp ah, SYS_CLEAR
    je .clear
    cmp ah, SYS_GETKEY
    je .getkey
    cmp ah, SYS_SETMODE
    je .setmode
    cmp ah, SYS_PUTPIXEL
    je .putpixel
    cmp ah, SYS_MEMSIZE
    je .memsize
    jmp .out                    ; unknown function: do nothing, do not hang

.putc:      call putc
            jmp .out
.puts:      call puts_far
            jmp .out
.newline:   call newline
            jmp .out
.clear:     call clear_screen
            jmp .out
.getkey:    call getkey         ; returns in AX
            jmp .out
.setmode:   call set_mode
            jmp .out
.putpixel:  call put_pixel
            jmp .out
.memsize:   int 0x12            ; returns in AX

.out:
    pop ds
    retf

; -----------------------------------------------------------------------------
%include "video.inc"
%include "keyboard.inc"
%include "string.inc"
%include "gfx.inc"

; =============================================================================
; Data
; =============================================================================
CMD_BUF_LEN equ 64

boot_drive  db 0

cmd_table:
    dw str_help,   cmd_help
    dw str_clear,  cmd_clear
    dw str_ver,    cmd_ver
    dw str_mem,    cmd_mem
    dw str_gfx,    cmd_gfx
    dw str_reboot, cmd_reboot
    dw 0

str_help    db 'help', 0
str_clear   db 'clear', 0
str_ver     db 'ver', 0
str_mem     db 'mem', 0
str_gfx     db 'gfx', 0
str_reboot  db 'reboot', 0

msg_banner  db 'jop 0.1 - 8086 real mode', 13, 10, 0
msg_hint    db "type 'help'", 13, 10, 13, 10, 0
msg_prompt  db 'jop> ', 0
msg_unknown db 'unknown command: ', 0
msg_mem     db 'conventional memory: ', 0
msg_kb      db ' KB', 13, 10, 0
msg_reboot  db 'rebooting...', 13, 10, 0
msg_help    db 'help    this list', 13, 10
            db 'clear   clear the screen', 13, 10
            db 'ver     version', 13, 10
            db 'mem     conventional memory size', 13, 10
            db 'gfx     mode 13h demo', 13, 10
            db 'reboot  restart', 13, 10, 0

cmd_buf     times CMD_BUF_LEN db 0
