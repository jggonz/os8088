# Page snapshots the Playwright MCP server drops in the working directory
.playwright-mcp/

# Python bytecode from tools/ being imported as a module (os88dbg)
__pycache__/
*.pyc

# BIOS ROMs are the machine's, not ours. CONTRIBUTING.md: the whole tree is MIT
# under one license file, and an IBM ROM cannot be given away under it. Drop
# your own copy in tools/martypc/roms/ - build.sh names the file it wants.
tools/martypc/roms/

# Claude Code's per-agent git worktrees. A subagent given `isolation: worktree`
# gets a checkout of this repo under here, so committing one would nest the
# whole tree inside itself; the harness removes them when the agent finishes.
.claude/worktrees/

# Third-party format specifications kept locally for reference (docs/BIFF-NOTES.md
# cites them). Not vendored: this tree is MIT under one licence file.
docs/excelfileformat.pdf
