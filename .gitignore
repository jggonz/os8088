build/
.DS_Store

# 86Box writes NVRAM and dumped BIOS ROMs next to the VM config.
# ONE WILDCARD, because the per-machine list drifted: it was 26 lines naming
# 26 of the 32 vm/ directories, and the six it had fallen behind on - 286-525,
# 286-runcpm, 386-xms, xt-runcpm, xt-sound-1.44, xt-weave-256 - would each have
# committed a BIOS ROM dump the first time anybody booted them. CLAUDE.md says
# every nvr/ is gitignored; this is what makes that true, and true for the next
# machine as well. vm/*/screenshots/ below has always been this shape.
vm/*/nvr/
# ...and 86Box's own screenshot directory. The collapse above dropped it by
# accident - the comment has named it as present ever since, and main still
# carried it, so the merge is where it comes back.
vm/*/screenshots/

# Page snapshots the Playwright MCP server drops in the working directory
.playwright-mcp/

# Python bytecode from tools/ being imported as a module (os88dbg)
__pycache__/
*.pyc

# BIOS ROMs are the machine's, not ours. CONTRIBUTING.md: the whole tree is MIT
# under one license file, and an IBM ROM cannot be given away under it. Drop
# your own copy in tools/martypc/roms/ - build.sh names the file it wants.
tools/martypc/roms/

# Claude Code's per-agent git worktrees. A subagent given `isolation: worktree`
# gets a checkout of this repo under here, so committing one would nest the
# whole tree inside itself; the harness removes them when the agent finishes.
.claude/worktrees/

# Third-party format specifications kept locally for reference (docs/BIFF-NOTES.md
# cites them). Not vendored: this tree is MIT under one licence file.
docs/excelfileformat.pdf
