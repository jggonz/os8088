build/
.DS_Store

# 86Box writes NVRAM and dumped BIOS ROMs next to the VM config
vm/xt/nvr/
vm/xt640/nvr/
vm/xt-cga/nvr/
vm/xt-hercules/nvr/
vm/286/nvr/
vm/386sx/nvr/
vm/386dx/nvr/
vm/*/screenshots/
vm/xt-sound/nvr/
vm/286-sound/nvr/
vm/386-sound/nvr/
vm/486/nvr/
vm/pentium/nvr/

# Python bytecode from tools/ being imported as a module (os88dbg)
__pycache__/
*.pyc

# BIOS ROMs are the machine's, not ours. CONTRIBUTING.md: the whole tree is MIT
# under one license file, and an IBM ROM cannot be given away under it. Drop
# your own copy in tools/martypc/roms/ - build.sh names the file it wants.
tools/martypc/roms/
