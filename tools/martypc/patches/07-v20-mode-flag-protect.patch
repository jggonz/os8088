@@ -506,6 +506,11 @@ pub struct NecVx0 {
     //ip:    u16,
     flags: u16,
     emulation_mode: bool,
+    // os8088: the MD flag's write enable. A V20 write-protects MD in native
+    // mode, so POPF and IRET cannot change it; BRKEM opens the protection for
+    // the length of an emulation session (an interrupt taken in 8080 mode
+    // pushes MD=0 and its RETI has to restore it) and RETEM closes it again.
+    md_write_enable: bool,
 
     address_bus: u32,
     address_latch: u32,
diff --git a/crates/marty_core/src/cpu_vx0/stack.rs b/crates/marty_core/src/cpu_vx0/stack.rs
index 255df5e5..8ebdd14b 100644
--- a/crates/marty_core/src/cpu_vx0/stack.rs
+++ b/crates/marty_core/src/cpu_vx0/stack.rs
@@ -230,8 +230,17 @@ impl NecVx0 {
         let int_was_set = self.get_flag(Flag::Interrupt);
 
         // Ensure state of reserved flag bits
+        let md_was = self.flags & CPU_FLAG_MODE;
         self.flags = result & FLAGS_POP_MASK;
         self.flags |= CPU_FLAGS_RESERVED_ON;
+        // os8088: MD is write-protected outside a BRKEM session. Without this
+        // the classic 8086/286/386 FLAGS probe (clear bits 12-15, read back)
+        // clears MD, reads 0x7000 and calls a V20 a 386; and any IRET frame
+        // built with bit 15 clear - an 8088 program's `push 0x0202 ... iret`
+        // task frame - drops the CPU into 8080 mode.
+        if !self.md_write_enable {
+            self.flags = (self.flags & !CPU_FLAG_MODE) | md_was;
+        }
 
         // Was interrupt flag just set? Set interrupt inhibit.
         let int_is_set = self.get_flag(Flag::Interrupt);
