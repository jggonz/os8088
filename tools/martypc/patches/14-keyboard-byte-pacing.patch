 pub const KB_UPDATE_RATE: f64 = 5000.0; // Keyboard device update rate in microseconds
+/// os8088: the least time between two bytes reaching the PPI, in microseconds.
+/// An XT keyboard cannot start clocking its next byte until the system has
+/// acknowledged the last one, and clocking one out takes about a millisecond,
+/// so no real machine sees two closer than that. Without it a byte the
+/// keyboard was holding went to the PPI the instant the ROM's int 09h
+/// acknowledged the last one - a few instructions before that handler's
+/// `sti` - and a scripted burst nested one int 09h inside the next until it
+/// had spent the interrupted task's whole stack.
+pub const KB_BYTE_US: f64 = 1000.0;
 
