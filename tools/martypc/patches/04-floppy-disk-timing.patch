+    /// One revolution, in microseconds. 200,000 on a 300 RPM drive.
+    pub fn revolution_us(&self) -> f64 {
+        60_000_000.0 / self.media_timing().0
+    }
+
+    /// Microseconds for one byte to pass the head. 32.0 at 250 kbit/s, so a
+    /// 512-byte sector's data field is 16.384 ms of the 200 ms revolution.
+    pub fn byte_us(&self) -> f64 {
+        8.0 * 1_000_000.0 / self.media_timing().1
+    }
+
+    /// Turn the platter.
+    ///
+    /// **Deliberately NOT gated on `motor_on`.** Upstream keeps that flag for
+    /// `ready` and ST3 and nothing ever depended on it being right, so it is
+    /// not: measured, it reads FALSE through every one of the boot's reads and
+    /// TRUE through `sysbench`'s, on the same machine in the same session. A
+    /// rotation model that believed it froze the platter in one context and
+    /// turned it in the other - and a frozen platter is not conservative, it
+    /// is OPTIMISTIC, because it presents the head at the same ideal angle for
+    /// every read instead of wherever the disk happens to be.
+    ///
+    /// A stopped platter's angle is unknowable anyway, and this model does not
+    /// claim to know it: what it must get right is that the disk keeps turning
+    /// while the guest thinks, so that the guest's own overhead SPENDS
+    /// rotational slack rather than adding to it. That is the whole difference
+    /// between 2 revolutions and 3 on a track read.
+    pub fn advance_rotation(&mut self, us: f64) {
+        if !self.disk_present {
+            return;
+        }
+        let rev = self.revolution_us();
+        if rev > 0.0 {
+            self.angle_us = (self.angle_us + us) % rev;
+        }
+    }
+
+    /// The physical order of the logical sectors around one track.
+    ///
+    /// `map[slot]` is the logical sector ID sitting in that angular slot. This
+    /// is how a track is laid down at format time: place sector 1, step
+    /// `interleave` slots, place sector 2, and take the next free slot when
+    /// stepping lands on an occupied one. At 2:1 with 9 sectors it produces
+    /// 1,6,2,7,3,8,4,9,5 - the layout the calibration machine's media has.
+    fn interleave_map(&self, spt: u8) -> Vec<u8> {
+        let spt = spt as usize;
+        let mut map = vec![0u8; spt];
+        if spt == 0 {
+            return map;
+        }
+        let il = (self.interleave.max(1) as usize) % spt.max(1);
+        let il = if il == 0 { 1 } else { il };
+
+        let mut slot = 0usize;
+        for s in 1..=spt {
+            while map[slot] != 0 {
+                slot = (slot + 1) % spt;
+            }
+            map[slot] = s as u8;
+            slot = (slot + il) % spt;
+        }
+        map
+    }
+
+    /// The logical sector `n` places after `start_id`, wrapping within the track.
+    pub fn wrap_sid(&self, start_id: u8, n: usize) -> u8 {
+        let spt = self.media_spt.max(1) as usize;
+        ((start_id.max(1) as usize - 1 + n) % spt) as u8 + 1
+    }
+
+    /// Time until logical sector `id`'s data starts passing the head, plus the
+    /// time for it to pass - and leave the head at the end of it.
+    ///
+    /// This is the unit the transfer is PACED in, one sector at a time, because
+    /// that is how a real drive delivers one: the controller starts DRQing as
+    /// soon as the first sector arrives and then pauses over each inter-sector
+    /// gap. Charging a whole multi-sector run as one silent lump instead is not
+    /// merely less faithful - it makes the drive appear dead for the length of
+    /// the run, and a BIOS that is watching for activity gives up. GLaBIOS
+    /// abandons a read after ~250 ms of nothing, which is less than the 305 ms
+    /// a 6-sector 2:1 run legitimately takes.
+    pub fn sector_time_us(&self, id: u8, sector_bytes: usize) -> f64 {
+        self.sector_time_from(id, sector_bytes, self.angle_us).0
+    }
+
+    /// The same, from a stated angle, answering (cost, where the head ends up).
+    ///
+    /// **It does not move the head, and that is the point.** The angle is a
+    /// pure function of elapsed time (`advance_rotation`), so a caller that
+    /// charges this cost and then lets that many microseconds pass finds the
+    /// head exactly where this says it will be - once, not twice. Setting it
+    /// here as well was a second opinion about the same quantity, and it had
+    /// to be paid for with a rule suppressing rotation for the length of an
+    /// operation, which is how the platter came to stop while the guest was
+    /// between two reads.
+    pub fn sector_time_from(&self, id: u8, sector_bytes: usize, angle: f64) -> (f64, f64) {
+        let (lat, xfer, end) = self.sector_split_from(id, sector_bytes, angle);
+        (lat + xfer, end)
+    }
+
+    /// The same, split into the WAIT for the sector to arrive and the time its
+    /// data takes to pass the head - because the bytes move during the second
+    /// part and not after it.
+    ///
+    /// Charging `latency + transfer` as one delay and then handing the DMA its
+    /// 512 bytes as fast as the guest can poll is not what a drive does: it
+    /// serialises media time and bus traffic that physically overlap, and on a
+    /// 9-sector read that appends ~4,600 guest instructions of BIOS wait loop
+    /// to the operation. That time lands in the gap between two reads, where
+    /// 28 ms of rotational slack decides whether the next one catches its
+    /// sector or waits another whole revolution.
+    pub fn sector_split_from(&self, id: u8, sector_bytes: usize, angle: f64) -> (f64, f64, f64) {
+        let spt = self.media_spt;
+        if spt == 0 {
+            return (0.0, 0.0, angle);
+        }
+
+        let rev = self.revolution_us();
+        let slot_us = rev / spt as f64;
+        let xfer_us = sector_bytes as f64 * self.byte_us();
+        let map = self.interleave_map(spt);
+
+        let slot = map.iter().position(|&s| s == id).unwrap_or(0);
+        let sector_start = slot as f64 * slot_us;
+
+        let mut wait = sector_start - angle;
+        if wait < 0.0 {
+            wait += rev;
+        }
+
+        (wait, xfer_us, (sector_start + xfer_us) % rev)
+    }
+
+    /// Just the wait for logical sector `id` to reach the head, from here.
+    pub fn sector_latency_us(&self, id: u8, sector_bytes: usize) -> f64 {
+        self.sector_split_from(id, sector_bytes, self.angle_us).0
+    }
+
+    /// The whole of a `count`-sector run, for callers that want the total
+    /// rather than the pacing. Kept in terms of `sector_time_us` so the two can
+    /// never disagree about what a run costs.
+    pub fn transfer_time_us(&self, start_id: u8, count: usize, sector_bytes: usize) -> f64 {
+        if self.media_spt == 0 || count == 0 {
+            return 0.0;
+        }
+
+        let mut total = 0.0;
+        let mut angle = self.angle_us;          // a LOCAL walk: see sector_time_from
+        for i in 0..count {
+            let id = self.wrap_sid(start_id, i);
+            let (cost, end) = self.sector_time_from(id, sector_bytes, angle);
+            total += cost;
+            angle = end;
+        }
+        total
+    }
+
+    /// os8088: Read Track and Format Track both stream from the index hole in
+    /// PHYSICAL order, so each costs the wait for the index plus one whole
+    /// revolution - interleave cannot help or hurt them.
+    pub fn track_time_us(&self) -> f64 {
+        let rev = self.revolution_us();
+        if rev <= 0.0 {
+            return 0.0;
+        }
+        (rev - self.angle_us) % rev + rev
+    }
+
+    /// Cylinders between the head and `target_c`.
+    pub fn seek_distance(&self, target_c: u16) -> u32 {
+        (target_c as i32 - self.cylinder as i32).unsigned_abs()
+    }
+
+    /// Head step time to `target_c`, plus the settle once it arrives.
+    ///
+    /// Unlike the rotational rows above this one is NOT independently
+    /// calibrated - the field's three raw `int 13h` rows all read one track
+    /// and never seek - so the step rate is taken from what the BIOS asked for
+    /// through the FDC's SPECIFY command rather than invented here.
+    pub fn seek_time_us(&self, target_c: u16, step_us: f64, settle_us: f64) -> f64 {
+        let dist = (target_c as i32 - self.cylinder as i32).unsigned_abs();
+        if dist == 0 {
+            return 0.0;
+        }
+        dist as f64 * step_us + settle_us
+    }
+
