+    /// The drive/media pair's rotational speed and MFM data rate.
+    ///
+    /// A 1.2M drive always spins at 360 RPM, so DD media in one streams at
+    /// 300 kbit/s rather than 250 - which is why the Compaq Portable III reads
+    /// a track in 1.24 revolutions where the 5150 needs 1.92 (Set 19).
+    fn media_timing(&self) -> (f64, f64) {
+        let hd_media = self.media_spt >= 15;
+        match self.drive_type {
+            FloppyDriveType::Floppy12M => {
+                if hd_media {
+                    (360.0, 500_000.0)
+                }
+                else {
+                    (360.0, 300_000.0)
+                }
+            }
+            FloppyDriveType::Floppy144M => {
+                if hd_media {
+                    (300.0, 500_000.0)
+                }
+                else {
+                    (300.0, 250_000.0)
+                }
+            }
+            // The 360K and 720K drives: 300 RPM, 250 kbit/s.
+            _ => (300.0, 250_000.0),
+        }
