     ///
     /// Ranges must have a granularity no less than MMIO_MAP_SIZE (8K).
     pub fn register_map(&mut self, device: MmioDeviceType, mem_descriptor: MemRangeDescriptor) {
+        // os8088: a range a device claims ONLY WHERE FREE (a lone Hercules's
+        // page 1, which a CGA in the same machine owns instead)
+        if mem_descriptor.priority == crate::devices::mda::HGC_PAGE1_IF_FREE {
+            let first = mem_descriptor.address >> MMIO_MAP_SHIFT;
+            let segs = mem_descriptor.size / MMIO_MAP_SIZE;
+            if (first..first + segs).any(|i| !matches!(self.mmio_map_fast[i], MmioDeviceType::Memory)) {
+                return;
+            }
+        }
         if mem_descriptor.address < self.mmio_data.first_map {
             self.mmio_data.first_map = mem_descriptor.address;
         }
