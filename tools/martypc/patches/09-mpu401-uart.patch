diff --git a/crates/marty_core/src/devices/mpu401.rs b/crates/marty_core/src/devices/mpu401.rs
new file mode 100644
index 00000000..994d5bb8
--- /dev/null
+++ b/crates/marty_core/src/devices/mpu401.rs
@@ -0,0 +1,119 @@
+/*
+    os8088: an MPU-401 in UART mode, which RECORDS what it is sent.
+
+    MartyPC has no MIDI interface, and os8088's MIDI out (SPEC.md 34.13) is
+    otherwise untestable here: there is no synthesiser to hear, and the
+    bytes are the whole of the behaviour anyway. So this card answers the
+    probe the way a real one does - a status port whose DRR is always clear,
+    an ACK (FEh) after RESET (FFh) and after the UART command (3Fh) - and
+    every byte written to its data port is kept with the emulated time it
+    arrived, for the debug server's `midi` command to hand to a test.
+
+    It is not an intelligent-mode MPU and does not pretend to be one: any
+    other command is ACKed and ignored, which is what a UART-only clone does.
+*/
+
+use crate::{
+    bus::{DeviceRunTimeUnit, IoDevice},
+    cpu_common::LogicAnalyzer,
+};
+use std::collections::VecDeque;
+
+pub const DEFAULT_MPU_BASE: u16 = 0x330;
+const LOG_MAX: usize = 1 << 20;
+
+pub struct Mpu401 {
+    io_base: u16,
+    uart: bool,
+    rx: VecDeque<u8>,
+    clock_us: f64,
+    /// (microseconds since the machine started, the byte)
+    pub log: Vec<(u64, u8)>,
+    pub dropped: u64,
+}
+
+impl Mpu401 {
+    pub fn new(io_base: u16) -> Self {
+        Self {
+            io_base,
+            uart: false,
+            rx: VecDeque::new(),
+            clock_us: 0.0,
+            log: Vec::new(),
+            dropped: 0,
+        }
+    }
+
+    pub fn run(&mut self, us: f64) {
+        self.clock_us += us;
+    }
+
+    pub fn uart(&self) -> bool {
+        self.uart
+    }
+}
+
+impl IoDevice for Mpu401 {
+    fn read_u8(&mut self, port: u16, _delta: DeviceRunTimeUnit) -> u8 {
+        match port.wrapping_sub(self.io_base) {
+            0 => self.rx.pop_front().unwrap_or(0xFF),
+            // Status: bit 6 DRR (0 = it takes a byte) is always clear; bit 7
+            // DSR (0 = a byte to read) is clear exactly while an ACK waits.
+            1 => {
+                if self.rx.is_empty() {
+                    0x80
+                }
+                else {
+                    0x00
+                }
+            }
+            _ => 0xFF,
+        }
+    }
+
+    fn write_u8(
+        &mut self,
+        port: u16,
+        data: u8,
+        _bus: Option<&mut crate::bus::BusInterface>,
+        _delta: DeviceRunTimeUnit,
+        _analyzer: Option<&mut LogicAnalyzer>,
+    ) {
+        match port.wrapping_sub(self.io_base) {
+            0 => {
+                if self.log.len() < LOG_MAX {
+                    self.log.push((self.clock_us as u64, data));
+                }
+                else {
+                    self.dropped += 1;
+                }
+            }
+            1 => {
+                match data {
+                    0xFF => {
+                        // RESET leaves UART mode - except that a real MPU in
+                        // UART mode does not ACK it, which is the one wrinkle
+                        // every driver handles; this one ACKs either way.
+                        self.uart = false;
+                        self.rx.clear();
+                        self.rx.push_back(0xFE);
+                    }
+                    0x3F => {
+                        self.uart = true;
+                        self.rx.push_back(0xFE);
+                    }
+                    _ => self.rx.push_back(0xFE),
+                }
+            }
+            _ => {}
+        }
+    }
+
+    #[rustfmt::skip]
+    fn port_list(&self) -> Vec<(String, u16)> {
+        vec![
+            (String::from("MPU-401 Data"),   self.io_base),
+            (String::from("MPU-401 Status"), self.io_base + 1),
+        ]
+    }
+}
