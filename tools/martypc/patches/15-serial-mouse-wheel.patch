+        }
+        if r_button_pressed {
+            byte1 |= MOUSE_UPDATE_RBUTTON;
+        }
+        let byte4 = (notches.clamp(-8, 7) as u8) & 0x0F;
+        self.updates.push_back(MouseUpdate::Wheel(byte1, 0, 0, byte4));
+    }
