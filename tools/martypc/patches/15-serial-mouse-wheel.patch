+    /// CURRENT ones, so a wheel turn can never read as a press or release.
+    pub fn wheel(&mut self, l_button_pressed: bool, r_button_pressed: bool, notches: i8) {
+        let mut byte1 = MOUSE_UPDATE_STARTBIT;
