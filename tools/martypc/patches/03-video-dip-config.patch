+/// Which display the machine's SW1-5/6 pair claims is PRIMARY.
+///
+/// It is a SETTING and not a description of what is installed: a 5150 can hold
+/// an MDA and a CGA at once, and the switches still say which one the BIOS
+/// brings up. Without this, `Ppi::new` derives the bits from the card list -
+/// "any CGA present -> CGA hires" - which cannot express a two-card machine
+/// whose switches say mono.
+#[derive(Copy, Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum VideoDipSetting {
+    Mda,
+    CgaLores,
+    CgaHires,
+    Expansion,
+}
+
 #[derive(Clone, Debug, Default)]
 pub struct MachineConfiguration {
     pub speaker: bool,
+    /// Override for the SW1 display bits; None = derive them from `video`.
+    pub video_dip: Option<VideoDipSetting>,
     pub ppi_turbo: Option<bool>,
     pub machine_type: MachineType,
     pub cpu: Option<CpuConfig>,
