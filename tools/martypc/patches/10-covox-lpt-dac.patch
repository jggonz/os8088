+    all copies or substantial portions of the Software.
+
+    THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+    DEALINGS IN THE SOFTWARE.
+
+    --------------------------------------------------------------------------
+*/
+
+//! A Covox Speech Thing (os8088 patch 10): an R-2R resistor ladder across the
+//! parallel port's eight data lines. Whatever byte the guest last wrote to the
+//! data register IS the output voltage - unsigned, 0x80 the middle - with no
+//! FIFO, no clock and no strobe. So this device holds the last data byte and
+//! samples it at a fixed rate (a zero-order hold), fast enough that a guest
+//! writing at any rate an ISA machine could reach is captured sample-exact
+//! for the gate's purposes (os8088 SPEC.md 34.14).
+
+use crate::{
+    channel::BidirectionalChannel,
+    device_traits::sounddevice::AudioSample,
+    devices::lpt_port::ParallelMessage,
+};
+
+use crossbeam_channel::Sender;
+
+pub const SAMPLE_RATE: u32 = 44100;
+pub const SAMPLE_TIME: f64 = 1_000_000.0 / SAMPLE_RATE as f64;
+
+pub struct Covox {
+    pub channel: BidirectionalChannel<ParallelMessage>,
+    pub sample_sender: Sender<AudioSample>,
+    pub data: u8,
+    pub sample_accum: f64,
+}
+
+impl Covox {
+    pub fn new(channel: BidirectionalChannel<ParallelMessage>, sample_sender: Sender<AudioSample>) -> Self {
+        Covox {
+            channel,
+            sample_sender,
+            data: 0x80,
+            sample_accum: 0.0,
+        }
+    }
+
+    pub fn sample_rate(&self) -> u32 {
+        SAMPLE_RATE
+    }
+
+    pub fn run(&mut self, usec: f64) {
+        // Every write since the last run, in order: the last one is the level.
+        while let Ok(message) = self.channel.try_recv() {
+            if let ParallelMessage::Data(data) = message {
+                self.data = data;
+            }
+        }
+        self.sample_accum += usec;
+        while self.sample_accum >= SAMPLE_TIME {
+            self.sample_accum -= SAMPLE_TIME;
+            let s = (self.data as f32 - 128.0) / 128.0;
+            let _ = self.sample_sender.send(s);
+        }
+    }
+}
