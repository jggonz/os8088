; =============================================================================
; os8088 - apps/pixelstein/pxlev.inc
;
; GENERATED by tools/pxslevel.py from apps/pixelstein/levels/*.txt - do not
; edit by hand (SPEC.md 97.12). tests/unit/t_pxsgen.py regenerates it on
; every `make`. THE LEVELS ARE NOT IN THIS FILE: they are the run-length
; stream the same tool writes with --stream, which the package carries as a
; lazy part (97.9) - this is the DIRECTORY into it, offsets and lengths and
; counts, so that a level edit is a diff a person can read.
;
; The cell byte (97.1): high nibble = material 1..15, 0 open; low nibble
; bit 0 SOLID, bit 1 DOOR, bit 2 DOOR_EW, bit 3 SPECIAL.
; =============================================================================

PXC_SOLID   equ 1
PXC_DOOR    equ 2
PXC_DOOREW  equ 4              ; the slab runs east-west
PXC_SPECIAL equ 8
PXM_JAMB    equ 15             ; the material beside a door, never in a level
PXM_DOOR    equ 12             ; the slab's own
PXM_SWITCH  equ 14             ; the elevator switch...
PXM_USED    equ 13             ; ...and what Use turns it into

; a level RECORD in the stream: 'PXL',1 then
PXL_MAPLEN  equ 4               ; word: run-length map bytes
PXL_SPAWNX  equ 6               ; word: Q8.8 - the tile's centre
PXL_SPAWNY  equ 8               ; word: Q8.8
PXL_SPAWNA  equ 10              ; word: the 12-bit heading
PXL_NDOORS  equ 12              ; byte
PXL_NACTORS equ 13              ; byte
PXL_NSTATIC equ 14              ; byte
PXL_HDR     equ 15              ; ...then the map (count, cell pairs), then
                                ; doors (cell word, flags, lock), actors
                                ; (cell word, kind, facing word), statics
                                ; (cell word, kind, blocking)
PXL_DOORSZ  equ 4
PXL_ACTSZ   equ 5
PXL_STATSZ  equ 4
PXL_MAXDOORS  equ 64
PXL_MAXACTORS equ 32
PXL_MAXSTATIC equ 96
PXL_PATROL    equ 128            ; the actor kind byte's bit 7: a patroller

PXL_NLEV    equ 8
PXL_STREAM  equ 9831             ; bytes in the whole stream
PXL_MAXREC  equ 1861             ; ...and its longest record: the claim

px_levdir:                       ; per level: word offset, word length,
                                ; word spawn cell, word spawn heading
    dw 0, 1054, 195, 0        ; E1M1: 22 doors, 7 actors, 27 statics
    dw 1054, 796, 1351, 3072        ; E1M2: 17 doors, 5 actors, 17 statics
    dw 1850, 892, 326, 0        ; E1M3: 16 doors, 7 actors, 17 statics
    dw 2742, 959, 454, 1024        ; E1M4: 20 doors, 10 actors, 17 statics
    dw 3701, 1273, 456, 1024        ; E1M5: 28 doors, 16 actors, 28 statics
    dw 4974, 1312, 519, 1024        ; E1M6: 26 doors, 17 actors, 33 statics
    dw 6286, 1684, 456, 1024        ; E1M7: 36 doors, 25 actors, 33 statics
    dw 7970, 1861, 456, 1024        ; E1M8: 38 doors, 32 actors, 37 statics
PXL_DIRSZ   equ 8

px_levpw:                        ; the floors' passwords, four letters each
                                ; (97.13: the LEVELDONE card shows the next
                                ; floor's, the attract page's C key takes one)
    db 'KEEP'                     ; E1M1
    db 'WARD'                     ; E1M2
    db 'CELL'                     ; E1M3
    db 'HALL'                     ; E1M4
    db 'IRON'                     ; E1M5
    db 'BELL'                     ; E1M6
    db 'GOLD'                     ; E1M7
    db 'PEAK'                     ; E1M8

