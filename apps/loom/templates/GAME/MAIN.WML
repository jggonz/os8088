<!-- GAME: a canvas, two sprites and art in SPRITES.WSP. The frame loop
     is native - script sees only events (WEAVE-SPEC 6.10). walls="TBLR"
     bounces all four edges; tick="12" fires ontick once a second at
     start(12). Keys: a up, z down. -->
<app name="Game" vm="16">
  <card id="main">
    <label style="bold">Game</label>
    <canvas id="field" w="160" h="96" br="1" walls="TBLR" tick="12"
            onkey="onKey" oncollide="onHit" ontick="onTick">
      <sprite id="ball" img="BALL" x="76" y="44"/>
      <sprite id="pad" img="PAD" x="8" y="42"/>
    </canvas>
    <button id="go" onclick="doStart" br="1">Start</button>
    <label id="out" w="12">Hits: 0</label>
    <meter id="clock" max="30" value="0"/>
  </card>
  <script src="MAIN.WJS"/>
</app>
