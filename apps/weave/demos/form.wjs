// FORM's handlers. 16-bit ints are THE number type; strings are immutable;
// handlers are the only entry points (WEAVE-SPEC 4.1).
var greets;

function doGreet() {
  var name;
  name = who.text;
  if (len(name) == 0) {
    alert("Type a name first.");
    return;
  }
  greets = greets + 1;
  if (greets > 10) { greets = 10; }
  count.value = greets;
  if (loud.checked) {
    status.text = "HELLO, " + name + "!";
  } else {
    status.text = "Hello, " + name + ".";
  }
}

function doReset() {
  greets = 0;
  count.value = 0;
  status.text = "Ready.";
  alert("Tally reset.", afterReset);
}

function afterReset(button) {
  status.text = "Reset done.";
}
