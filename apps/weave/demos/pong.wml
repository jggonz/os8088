<!-- PONG: the canvas component - two paddles, a ball, sub-pixel
     velocities, oncollide/onscore handlers, tones, and a bounded per-frame
     hook. Top and bottom walls bounce; left and right are open edges, so a
     ball fully out fires onscore (WEAVE-SPEC 6.10). You are the LEFT
     paddle: a up, z down. The RIGHT one is the computer's, steered from
     ontick every frame (tick="1") inside WEAVE-SPEC 4.11.1's budget.

     ...and WEAVE-SPEC 6.10.7's palette, which is a <canvas> and its
     <sprite>s and nothing else on the card: the score is a plain <label>
     and is a plain <label> on VGA too, because state never rides on colour
     (SPEC.md 39.4). `paper="black"` is legal against all sixteen inks - 0
     is a subset of every colour - so this palette never meets 5.4.2.2's
     fourth refusal. On CGA and Hercules the load path does not read these
     three attributes AT ALL and the game is pixel-identical to the one
     wave 5 shipped (WEAVE-SPEC 9.2.1). -->
<app name="Pong" vm="16">
  <card id="main">
    <label style="bold">Weave Pong</label>
    <label id="score" align="right" w="12">0 : 0</label>
    <canvas id="field" w="240" h="120" br="1" walls="TB" tick="1"
            ink="white" paper="black"
            onkey="onPad" oncollide="onHit" onscore="onGoal"
            ontick="onTick">
      <sprite id="ball" img="BALL" x="116" y="56" color="yellow"/>
      <sprite id="pad" img="PAD" x="4" y="48" color="lightcyan"/>
      <sprite id="cpu" img="PAD" x="228" y="48" color="lightmagenta"/>
    </canvas>
    <button id="serve" onclick="doServe" br="1">Serve</button>
  </card>
  <script src="PONG.WJS"/>
</app>
