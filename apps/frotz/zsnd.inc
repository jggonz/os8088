; =============================================================================
; os8088 - apps/frotz/zsnd.inc
;
; @sound_effect, and nothing else. This module owns every sound Frotz makes
; and every decision about what a story's request maps onto (Standard 9,
; docs/plans/completed/FROTZ-PLAN.md 7).
;
; THE DECISION THAT SHAPES IT: the Standard divides sound into two things that
; are not variations of each other. Effects 1 and 2 are BLEEPS - "immediate
; and brief" (Standard 9.4), generated by the interpreter, and the only sound
; the v3 Infocom games ever ask for. Effects 3 and up are SAMPLES the
; interpreter "is simply expected to know where to find" (Standard 9.1), and
; Frotz ships no sound archive, so it knows where to find none of them.
;
; So the two halves are answered differently and deliberately:
;
;  - **A bleep is a tone, on every machine.** OSAPI_SND_TONE is resident: the
;    PIT and port 61h are in every PC that can boot this OS, so effects 1 and
;    2 work on the floor machine with no driver, no card and no refusal path.
;    They are the sounds that must not depend on anything.
;
;  - **A sampled effect gets the nearest tone, never silence.** A story that
;    asks for effect 7 knows what effect 7 means and we do not, but silence is
;    the one answer that is certainly wrong - it reads as a broken interpreter
;    rather than as an approximation. With a sound driver attached we can do
;    better than a square wave: a percussive FM voice on the OPL2 decays by
;    itself and sounds like something struck, which is what most of these
;    effects were. Which of the two we get is asked for with OSAPI_SND_CAPS
;    and never assumed (SPEC.md 34.2's claim that caps is a constant is stale
;    - the code ORs in the driver's bits).
;
;  - **Silence IS the answer for a number that does not exist**, and the
;    Standard's own Remarks say why: 'The Lurking Horror' emits
;    `sound_effect 4095 2 15` "probably due to a bug in its own code". A tone
;    invented for 4095 is not an approximation of anything - it is noise the
;    story never asked for. ZS_LAST is that boundary.
;
; SOUND IS ASKED FOR FROM THE WORKER. That is off the SDK's worker-safe list
; on paper (apps/os88api.inc), and it is correct, for the reason
; apps/arkanoid/arkanoid.asm already documents in its file header: only the
; BLOCKING slots - SND_PLAY and SND_STREAM's open verbs - are forbidden to a
; worker, and for a different reason (they freeze the desktop for the length
; of the clip). `snd_req_inst` (SPEC.md 34.3) falls back to the running task's
; T_INST when no callback is being dispatched, so a tone our worker asks for
; is attributed to our instance and released by `snd_release_inst` at
; teardown like any other. Every tone here is duration-limited, so it expires
; in `snd_tick` and the worker never has to come back to silence it. This
; follows Arkanoid rather than inventing a second answer.
;
; A refusal is ignored on every path. Sound is decoration in a text adventure,
; and a turn that stalled for the speaker would be worse than a quiet one -
; Arkanoid's words, and they are truer here, where the sound is a substitute
; for a sample we do not have in the first place.
; =============================================================================

; --- the two bleeps (Standard 9.2: 1 high, 2 low) ----------------------------
; Two octaves apart so nobody has to be told which is which, and 2 ticks
; (~110 ms) because "brief" is in the Standard's own sentence. Same duration
; Arkanoid uses for a bat hit.
ZS_HI_HZ    equ 1760                ; A6
ZS_LO_HZ    equ 440                 ; A4
ZS_BLEEP    equ 2                   ; ticks, at 18.2 Hz

ZS_PRI      equ 0x40                ; SND_PRI_PKG, the documented package
                                    ; priority. A kernel alert (0xC0) outranks
                                    ; a story's sound effect and should.

ZS_FIRST    equ 3                   ; the first SAMPLED effect number
ZS_LAST     equ 18                  ; ...and the last one we will answer at all

ZS_CH       equ 0                   ; the one FM channel we key. Channel 8 is
                                    ; the tone tier's voice and not ours
                                    ; (SPEC.md 34.8); one channel is enough
                                    ; because we can only ever have one
                                    ; substitute sounding - see zs_effect.

; --- our slice of the bss (apps/frotz/zbss.inc, ZSND_SLACK: 64 bytes) --------
; zs_caps/zs_capsok are named in zbss.inc itself; these four are the state
; this module needed that the map did not anticipate.
%define zs_patch      (os88_image_end + ZSND_SLACK + 0)   ; 11: the working
                                                          ; patch, volume-scaled
%define zs_until      (os88_image_end + ZSND_SLACK + 12)  ; word: the tick our
                                                          ; tone expires at
%define zs_livet      (os88_image_end + ZSND_SLACK + 14)  ; byte: we were granted
                                                          ; the tone channel
%define zs_livef      (os88_image_end + ZSND_SLACK + 15)  ; byte: we hold an FM
                                                          ; channel

; =============================================================================
; zs_effect - @sound_effect (Standard 9.4, VAR:245)
; in:  AX = sound number, BL = effect (1 prepare, 2 start, 3 stop, 4 finish
;      with), BH = volume/repeats
; out: nothing; preserves every register
;
; The four operations, and why two of them do nothing:
;
;   1 prepare      Standard 9.4.1 - a hint that the game will want the effect
;                  soon, so the interpreter can load it off disc into a cache.
;                  Our substitutes are three bytes of image each. There is
;                  nothing to load and nothing to cache, so this is genuinely
;                  complete as a no-op, not deferred.
;   2 start        the sound.
;   3 stop         silence ours. The number is ignored: Infocom's own stories
;                  write both `sound_effect 0 3` and `sound_effect number 3`
;                  (Standard 9's Remarks) and with one voice they mean the
;                  same thing.
;   4 finish with  Standard 9.4.5 - permission to throw the effect out of
;                  memory. Nothing is in memory. A no-op for the same reason
;                  as prepare, and it must NOT silence: "finish with" is
;                  explicitly not "stop".
;
; Effect 0 is also taken as a start, because the operand is optional and
; `@sound_effect 1` with no effect operand is the bleep every v3 story makes
; (Standard 9's Remarks). Whether the default arrives here as 2 or as 0 is
; zexec.inc's decode; both work, so neither module has to know the other's
; choice.
;
; ES is pushed and popped although nothing here should disturb it: this runs
; with ES = the story segment (docs/plans/completed/FROTZ-PLAN.md 3.1), OSAPI_SND_FM is
; X-stubbed (the stub restores the caller's ES) and the plain slots preserve
; it - but an ES that came back wrong would corrupt the machine's memory
; silently, and two bytes of stack is not a price.
; =============================================================================
zs_effect:
    push ax
    push bx
    push cx
    push dx
    push si
    push es

    mov si, ax                      ; SI = the sound number; AX is about to be
                                    ; the caps word
    call zs_caps_get
    test al, SND_CAP_TONE
    jz .out                         ; no sink at all: silence is the whole
                                    ; honest answer (SND_CAP_TONE is always
                                    ; set today; this is a fact we test rather
                                    ; than a promise we assume)

    cmp bl, 3
    je .stop
    cmp bl, 2
    je .start
    or bl, bl
    jnz .out                        ; 1 and 4: nothing to load, nothing to free

.start:
    or si, si
    jz .out                         ; number 0 only means anything to stop
    cmp si, ZS_FIRST
    jb .bleep
    cmp si, ZS_LAST
    ja .out                         ; a number no story can have meant

    ; --- a sampled effect we do not have --------------------------------------
    ; Starting one implicitly stops the one before it, which is what the
    ; Standard asks for (9.4.2: a new sample stops the current sample). Both
    ; sinks do it for us: the FM path re-keys the same channel, and the tone
    ; channel has one owner and no mixing anywhere in the system.
    mov ax, si
    sub ax, ZS_FIRST
    mov cx, 3                       ; ZS_ENT bytes per entry
    mul cx                          ; DX:AX - DX is 0, the index is < 16
    mov si, ax
    add si, zs_tab
    mov ax, [si]                    ; the substitute's frequency
    mov cl, [si+2]                  ; ...and its length in ticks
    xor ch, ch

    test byte [zs_caps], SND_CAP_FM
    jz .tone
    call zs_fm                      ; CF=1: the driver went away since we
    jnc .out                        ; cached the caps, or the chip refused
    jmp short .tone

.bleep:                             ; --- 1 and 2, on every machine ------------
    mov ax, ZS_HI_HZ
    cmp si, 1
    je .b1
    mov ax, ZS_LO_HZ
.b1:
    mov cx, ZS_BLEEP

.tone:
    call zs_tone
    jmp short .out

.stop:
    call zs_silence

.out:
    pop es
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret

; -----------------------------------------------------------------------------
; zs_tone - one duration-limited tone, fire and forget
; in:  AX = frequency Hz, CX = duration in ticks
; out: nothing; preserves every register
;
; The Arkanoid idiom (ark_beep_n), plus one thing Arkanoid does not need: we
; bank the tick the tone expires at, because zs_silence must be able to tell
; "our tone is still sounding" from "our tone expired and somebody else owns
; the speaker now". Tone-off obeys the same priority compare as tone-on
; (SPEC.md 34.1), so an off sent at ZS_PRI after ours expired would silence
; another package's tone of equal priority - a bug that would only ever show
; up as somebody else's app going quiet.
;
; CF=1 (something louder owns the speaker) is dropped on purpose: nothing was
; granted, so there is nothing to remember and nothing to report.
; -----------------------------------------------------------------------------
zs_tone:
    push ax
    push cx
    push dx
    mov dl, ZS_PRI
    call OSAPI_SND_TONE             ; duration-limited: snd_tick turns it off,
    jc .out                         ; so the worker never comes back for it
    mov byte [zs_livet], 1
    call OSAPI_GET_TICKS            ; AX = [ticks]
    add ax, cx                      ; wraps with the counter; the compare in
    mov [zs_until], ax              ; zs_silence is signed, so that is fine
.out:
    pop dx
    pop cx
    pop ax
    ret

; -----------------------------------------------------------------------------
; zs_fm - the substitute a machine with an OPL2 gets instead
; in:  AX = frequency Hz (19..6208), BH = the volume/repeats operand
; out: CF = 0 keyed, CF = 1 refused - the caller falls back to a tone;
;      preserves every register
;
; WHY THIS SOUNDS LIKE A SAMPLE AND A SQUARE WAVE DOES NOT: the patch is
; PERCUSSIVE - EGT clear on both operators, sustain level 0 - so the envelope
; runs attack, then release, and reaches silence on its own. That is the whole
; reason to use FM here rather than a longer tone: the effect decays like
; something struck instead of stopping like something switched off, and it
; needs no note-off, no timer and no second visit from the worker. Frotz has
; nowhere to put a "turn it off now" callback, so a voice that did not silence
; itself would drone until the next opcode that happened to make a sound.
;
; The note-off before the note-on is not tidiness: an OPL2 envelope retriggers
; only on a 0->1 key transition, and opl_keyon (drivers/sound/sound.asm)
; writes B0h with KEY-ON set unconditionally. Without the key-off, a second
; effect keyed while the first was still ringing would change the pitch of a
; decaying note instead of starting a new one.
; -----------------------------------------------------------------------------
zs_fm:
    push ax
    push bx
    push cx
    push si
    push di
    push ax                         ; the frequency, wanted in BX at note-on

    ; --- stage a private copy of the patch and scale the carrier ------------
    ; The image copy is per-instance and writable (SPEC.md 20.1), but two
    ; volumes in one story would then fight over it, and a claim's bss is
    ; where mutable state belongs.
    mov si, zs_patch0
    mov di, zs_patch
    mov cx, ZS_PATCH_N
.copy:                              ; not movsb: ES is the STORY here, not us
    mov al, [si]
    mov [di], al
    inc si
    inc di
    loop .copy

    ; Volume 1..8, 8 loudest; -1 is "loudest possible" (Standard 9.3), and an
    ; absent operand arrives as 0. The OPL's total level is ATTENUATION in
    ; 0.75 dB steps, so loud is 0 and each level down costs 3 dB.
    mov al, bh
    or al, al
    jz .loud
    cmp al, 8
    jae .loud                       ; catches 8 and 0FFh in one test
    mov cl, 8
    sub cl, al
    mov al, cl
    shl al, 1
    shl al, 1                       ; att = (8 - volume) * 4
    jmp short .setl
.loud:
    xor al, al
.setl:
    mov [zs_patch + ZS_TL_CAR], al

    mov cl, ZS_CH
    mov si, zs_patch
    mov al, 2                       ; verb 2: patch-load. It claims the channel
    call OSAPI_SND_FM               ; and stages SI out of our segment for us
    jc .no
    mov byte [zs_livef], 1

    mov al, 1                       ; verb 1: note-off, for the retrigger. It
    call OSAPI_SND_FM               ; refuses harmlessly if nothing is keyed

    pop bx                          ; BX = the frequency (pushed on entry)
    push bx
    mov al, 0                       ; verb 0: note-on
    call OSAPI_SND_FM
    jc .rollback
    clc
    jmp short .out

.rollback:                          ; a claim with nothing sounding is worse
    mov al, 3                       ; than no claim - the driver's own rule
    call OSAPI_SND_FM               ; for a refused note-on
    mov byte [zs_livef], 0
.no:
    stc
.out:
    pop ax                          ; the frequency we parked
    pop di
    pop si
    pop cx
    pop bx
    pop ax
    ret

; -----------------------------------------------------------------------------
; zs_silence - stop whatever WE started, and nothing anyone else did
; in:  nothing
; out: nothing; preserves every register
;
; Both halves are guarded, and both guards are about not silencing another
; package: the FM all-off releases only what this requester holds (verb 3 is
; per-instance, drivers/sound/sound.asm), and the tone-off is sent only while
; our own grant can still be live. The tick compare is SIGNED against the
; difference so it survives the 18.2 Hz counter wrapping every hour - the same
; shape apps/piano/piano.asm's wait uses.
; -----------------------------------------------------------------------------
zs_silence:
    push ax
    push cx
    push dx

    cmp byte [zs_livef], 0
    je .tone
    mov al, 3                       ; verb 3: all-off, ours only
    call OSAPI_SND_FM
    mov byte [zs_livef], 0

.tone:
    cmp byte [zs_livet], 0
    je .out
    mov byte [zs_livet], 0
    call OSAPI_GET_TICKS
    mov cx, [zs_until]
    sub cx, ax
    js .out                         ; already expired: the speaker is not ours
    xor ax, ax                      ; AX = 0: tone off
    xor cx, cx
    mov dl, ZS_PRI
    call OSAPI_SND_TONE
.out:
    pop dx
    pop cx
    pop ax
    ret

; -----------------------------------------------------------------------------
; zs_caps_get - the machine's sound capabilities, asked once
; in:  nothing
; out: AX = the OSAPI_SND_CAPS word (SND_CAP_*); preserves every register else
;
; Cached, and that is the correct behaviour rather than a saving. Caps are
; runtime state - the Control Panel can attach and detach a driver mid-session
; - but Frotz commits to an answer the moment zm_setup writes the story
; header: Standard 9.1.1 says a v6 interpreter sets Flags 1 bit 5 if it can
; provide sound beyond a bleep, and 9.1.2 says a v5+ interpreter clears
; Flags 2 bit 7 if it cannot oblige. Those bits are written once and the story
; reads them all game. Re-reading here would let the two disagree, which is
; the one failure a story cannot defend against. So we answer with what we
; promised, and a driver that has since gone away is handled where it belongs:
; zs_fm's refusal falls back to a tone.
; -----------------------------------------------------------------------------
zs_caps_get:
    cmp byte [zs_capsok], 0
    jne .have
    push bx
    push dx
    call OSAPI_SND_CAPS             ; AX = caps, BL = live tone route,
    mov [zs_caps], ax               ; DX = presence bits
    mov byte [zs_capsok], 1
    pop dx
    pop bx
    ret
.have:
    mov ax, [zs_caps]
    ret

; =============================================================================
; The substitutes
; =============================================================================
; One entry per sampled effect number ZS_FIRST..ZS_LAST: a frequency and a
; length in ticks. Three bytes each, and the whole table is 48.
;
; The numbers mean nothing to us - only the story's own manual knows what
; effect 9 is - so the table has exactly two jobs, and musicality is not one
; of them. (1) Two different effects must not sound the same, or a story that
; uses sound to distinguish two events has been made to lie. Hence the
; deliberate zig-zag: no two neighbours are close in pitch, and a scale was
; avoided precisely because a scale makes everything sound like one
; instrument playing. (2) No effect may outlast the turn it belongs to: 2 to 7
; ticks is 110 ms to 385 ms, short enough that TLH's habit of firing several
; effects in one game round does not turn into a queue of noise, and every one
; of them is inside OSAPI_SND_TONE's 19..20000 Hz and OSAPI_SND_FM's
; 19..6208 Hz windows by inspection.
ZS_ENT      equ 3

zs_tab:
    dw 1200
    db 3                            ; 3
    dw 900
    db 3                            ; 4
    dw 700
    db 4                            ; 5
    dw 1500
    db 2                            ; 6
    dw 550
    db 5                            ; 7
    dw 2000
    db 2                            ; 8
    dw 440
    db 5                            ; 9
    dw 1100
    db 3                            ; 10
    dw 330
    db 6                            ; 11
    dw 1750
    db 2                            ; 12
    dw 660
    db 4                            ; 13
    dw 250
    db 6                            ; 14
    dw 1350
    db 3                            ; 15
    dw 500
    db 5                            ; 16
    dw 2200
    db 2                            ; 17
    dw 200
    db 7                            ; 18
zs_tab_end:

%if (zs_tab_end - zs_tab) != ((ZS_LAST - ZS_FIRST + 1) * ZS_ENT)
    %error "zsnd.inc: zs_tab does not cover ZS_FIRST..ZS_LAST"
%endif

; --- the percussive FM patch (11 bytes, SPEC.md 34.2's layout) ---------------
; Five modulator registers (20h, 40h, 60h, 80h, E0h), five carrier, then C0h -
; the layout tests/fmtest/fmtest.asm's gate patch pins.
;
; EGT is CLEAR on both operators, so neither sustains: the envelope goes
; attack, then release at RR, and arrives at silence without a key-off. That
; is the entire point (see zs_fm). SL is 0 so the decay phase ends at once and
; the whole tail is the release; RR 5 puts it at a few hundred ms, in the same
; range as the tick counts in zs_tab so the two agree about how long an effect
; lasts.
;
; The modulator runs at twice the carrier's frequency at -9 dB: enough odd
; harmonics to read as a struck object rather than a whistle, not so much that
; it becomes a buzz. The carrier's total level is the ONE byte zs_fm rewrites,
; and ZS_TL_CAR is its index - a literal 6 here would be the sort of constant
; that survives a patch edit and then attenuates the wrong operator.
ZS_PATCH_N  equ 11
ZS_TL_CAR   equ 6                   ; carrier 40h: KSL | total level

zs_patch0:
    db 0x02, 0x0C, 0xF2, 0x05, 0x00 ; modulator: MULT=2, -9 dB, AR15/DR2, RR5
    db 0x01, 0x00, 0xF0, 0x05, 0x00 ; carrier:   MULT=1, level set at run time
    db 0x00                         ; C0h: FM connection, no feedback
zs_patch0_end:

%if (zs_patch0_end - zs_patch0) != ZS_PATCH_N
    %error "zsnd.inc: the FM patch is not 11 bytes"
%endif
