5 REM EXAMPLE: FORM CONTROLS AND MOUSE EVENTS
10 SCREEN 0
20 COLOR 0,15
30 CLS
40 PRINT "FORM EVENT EXAMPLE"
50 FORM "EXAMPLE FORM",250,126,NO
60 FRAME 1,8,8,230,106,"OPTIONS"
70 LABEL 2,16,25,"CLICK CHECKBOX OR DONE"
80 CHECKBOX 3,16,50,"ENABLE OPTION"
90 BUTTON 4,130,78,90,22,"DONE"
100 SHOWFORM
110 A=EVENT
120 IF A=3 THEN 160
130 IF A=4 THEN 200
140 IF A=-1 THEN 210
150 GOTO 110
160 B=VALUE(3)
170 PRINT "CHECKBOX VALUE=";B
180 GOTO 110
200 CLOSEFORM
210 PRINT "FORM EXAMPLE COMPLETE"
220 END
