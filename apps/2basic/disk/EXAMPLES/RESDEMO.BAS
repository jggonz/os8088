5 REM EXAMPLE: NAMED 2BR3 SPRITES AND GAME DATA
10 SCREEN 0
20 COLOR 0,15
30 CLS
40 PRINT "NAMED RESOURCES EXAMPLE"
50 LOADRES "RESDEMO"
60 PRINT "TILES=";RESCOUNT("TILES")
70 PRINT "MAP LENGTH=";RESLEN("MAP")
80 PRINT "MAP FIRST BYTE=";RESBYTE("MAP",0)
90 PRINT "SCORE FIRST WORD=";RESWORD("SCORES",0)
100 PRINT "TARGET WORD 1=";RESLINE$("TARGETS",0)
110 PRINT "TARGET WORD 2=";RESLINE$("TARGETS",1)
120 RESSELECT "TILES"
130 SCREEN 1
140 COLOR 15,0
150 DRAWBEGIN
160 CLS
170 FILLBOX (8,24)-(190,112),1
180 PUTRES 0,24,44,15,0
190 PUTRES 1,64,44,14,1
200 PUTRES 2,104,44,10,2
210 PUTRES 3,144,44,12,3
220 DRAWEND
230 SLEEP 54
240 SCREEN 0
250 COLOR 0,15
260 CLS
270 PRINT "RESOURCE EXAMPLE COMPLETE"
280 END
