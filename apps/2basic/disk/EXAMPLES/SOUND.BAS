5 REM EXAMPLE: BEEP TONES AND OPTIONAL ADLIB FM
10 SCREEN 0
20 COLOR 0,15
30 CLS
40 PRINT "SOUND EXAMPLE"
50 PRINT "LISTEN FOR FOUR NOTES"
60 BEEP
70 SOUND 262,3
80 SOUND 330,3
90 SOUND 392,3
100 SOUND 523,5
110 IF ADLIB=0 THEN 220
120 PRINT "ADLIB AVAILABLE - FM MELODY"
130 FMPRESET 0,0
140 FMNOTE 0,440
150 SLEEP 8
160 FMOFF 0
170 FMNOTE 0,660
180 SLEEP 8
190 FMSTOP
200 GOTO 230
220 PRINT "ADLIB NOT DETECTED - FM SKIPPED"
230 PRINT "SOUND EXAMPLE COMPLETE"
240 END
