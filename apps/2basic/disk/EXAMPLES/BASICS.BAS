5 REM EXAMPLE: VARIABLES LOOPS ARRAYS AND STRING CONVERSION
10 SCREEN 0
20 COLOR 0,15
30 CLS
40 PRINT "BASIC LANGUAGE EXAMPLE"
50 A=2+3*4
60 PRINT "2+3*4 = ";A
70 DIM Z(5)
80 FOR I=0 TO 5
90 Z(I)=I*I
100 NEXT I
110 PRINT "SQUARES FROM 0 TO 5"
120 FOR I=0 TO 5
130 PRINT I;" SQUARED IS ";Z(I)
140 NEXT I
150 GOSUB 500
160 PRINT "STR$(123) = ";STR$(123)
170 PRINT "VAL(STR$(-7)) = ";VAL(STR$(-7))
180 PRINT "DONE. TRY LIST OR EDIT."
190 END
500 PRINT "GOSUB SUBROUTINE CALLED"
510 RETURN
