5 REM 2BASIC BUILD 26 FORM / EVENT UAT
10 CONSOLESIZE 40,18
20 SCREEN 0
25 COLOR 0,15
30 CLS
40 PRINT "UTFORM - TEST CONTROLS"
50 LOADBMP "UTICON",0
60 FORM "UAT FORM",280,160,YES
70 FRAME 10,8,8,260,135,"FRAME"
80 LABEL 1,20,30,"READY"
90 CHECKBOX 3,20,60,"CHECK ME"
100 BUTTON 2,20,100,95,22,"FINISH"
110 IMAGE 4,0,170,60
120 SETTEXT 1,"CHECK BOX THEN FINISH"
130 SETVALUE 3,1
140 IF VALUE(3)<>1 THEN 9000
150 ENABLE 2,0
160 VISIBLE 4,0
170 SHOWFORM
180 SLEEP 36
190 VISIBLE 4,1
200 ENABLE 2,1
210 PRINT "FINISH BUTTON NOW ENABLED"
220 A=EVENT
230 IF A=2 THEN 350
240 IF A=3 THEN 270
250 IF A=4 THEN 310
260 GOTO 220
270 B=VALUE(3)
280 PRINT "CHECKBOX VALUE=";B
290 GOTO 220
310 PRINT "IMAGE CLICK EVENT=4"
320 GOTO 220
350 CLOSEFORM
360 RESTORECONSOLE
370 FREEBMP 0
380 PRINT "UTFORM DONE: VISUAL SIGN-OFF"
390 END
9000 PRINT "UTFORM FAIL VALUE(3)"
9010 CLOSEFORM
9020 END
