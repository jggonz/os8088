5 REM 2BASIC BUILD 26 INPUT / DIALOG UAT
10 SCREEN 0
20 COLOR 0,15
30 CLS
40 PRINT "UTINPUT - MOVE MOUSE + CLICK"
50 PRINT "MOUSEX=";MOUSEX;" Y=";MOUSEY
60 LOCATE 4,2
70 PRINT "LOCAL X=";MOUSELX;" Y=";MOUSELY;"     ";
80 IF MOUSEB<>0 THEN 120
90 SLEEP 2
100 GOTO 60
120 PRINT
130 PRINT "DESKTOP: ";SCREENW;"x";SCREENH
140 PRINT "BPP=";SCREENBPP;" MODE=";VIDEOMODE
150 INPUT "TYPE 12";A
160 IF A<>12 THEN 9000
170 B=0
180 INPUTBOX "TYPE 34",B
190 IF B<>34 THEN 9000
200 MESSAGEBOX "INPUT + INPUTBOX PASS"
210 PRINT "PRESS SPACE TO FINISH"
220 K=INKEY
230 IF K=32 THEN 260
240 SLEEP 1
250 GOTO 220
260 PRINT "UTINPUT PASS"
270 END
9000 PRINT "UTINPUT FAILED - RETRY"
9010 END
