5 REM B37 ISOLATED CONTROL STATE AND LABEL TEST
10 SCREEN 0
20 COLOR 0,15
30 CLS
40 PRINT "FORMISO - CONTROL STATE"
50 FORM "FORMISO",240,124,NO
60 FRAME 1,8,8,220,100,"CONTROL STATE"
70 LABEL 2,16,24,"INITIAL"
80 CHECKBOX 3,16,46,"CHECK ME"
90 SETVALUE 3,1
100 IF VALUE(3)<>1 THEN 9000
110 SETVALUE 3,0
120 IF VALUE(3)<>0 THEN 9000
130 ENABLE 3,0
140 ENABLE 3,1
150 VISIBLE 2,0
160 VISIBLE 2,1
170 LABEL 4,16,74,"1: LABEL AFTER STATE"
180 CLOSEFORM
190 PRINT "FORMISO PASS: 6 CHECKS"
200 END
9000 COLOR 4,15
9010 PRINT "FORMISO FAIL: VALUE(3)"
9020 CLOSEFORM
9030 END
