    MRBUF mrt_amp,    128    ; MIDI level -> the synth's amplitude, a square law
    MRBUF mrt_fn,     768    ; OPL F-Number at block = octave - 1, 1/32 semitone steps
    MRBUF mrt_fq,     768    ; octave 0's frequency x 2048, the same steps
